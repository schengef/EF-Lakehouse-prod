		lineageTag: 4f761419-5617-4d7a-ad75-f52617406059

		changedProperty = DisplayFolder

	measure 'Executive Summary InTransit TY' =
			
			switch(
			        selectedvalue('Headers - Inventory Summary'[Business Unit]),
			        "Wholesale",
			            SWITCH(
			                SELECTEDVALUE('Headers - Inventory Summary'[Period]),
			                "Week to Date",[Executive Summary InTransit Wholesale WTD TY],
			                "Month to Date",[Executive Summary InTransit Wholesale MTD TY],
			                "Year to Date",[Executive Summary InTransit Wholesale YTD TY]
			            ),
			        "DTC",
			            SWITCH(
			                SELECTEDVALUE('Headers - Inventory Summary'[Period]),
			                "Week to Date",[Executive Summary InTransit DTC WTD TY],
			                "Month to Date",[Executive Summary InTransit DTC MTD TY],
			                "Year to Date",[Executive Summary InTransit DTC YTD TY]
			            ),
			        "Total Company",
			            SWITCH(
			                SELECTEDVALUE('Headers - Inventory Summary'[Period]),
			                "Week to Date",[Executive Summary InTransit Total WTD TY],
			                "Month to Date",[Executive Summary InTransit Total MTD TY],
			                "Year to Date",[Executive Summary InTransit Total YTD TY]
			            )
			        )
