table A-measure
	lineageTag: dc6e990c-8ba9-44b9-ae45-d7bbae5c7200

	measure test = ```
			
			VAR LastDayAvailable = max('Date'[Date])+ if(max('Date'[Date])>=today(),WEEKDAY(today(), 1)-8,0)
			VAR LastDayLY=LOOKUPVALUE('Date EOY'[Date LY],'Date EOY'[Date],LastDayAvailable)
			VAR LW=SUMMARIZECOLUMNS('Date EOY'[Date LY], FILTER('Date EOY','Date EOY'[Week End Date]=max('Date EOY'[Week End Date])))    
			Return LastDayLY
			// CALCULATE (
			//     [DTC Shipped Units],
			//        ALLEXCEPT('Date EOY', 'Date EOY'[Select a Calendar]),
			//     'Date EOY'[Date] in LW &&
			//     'Date EOY'[Date]<=LastDayLY         
			// )
			```
		formatString: General Date
		lineageTag: 9fbad500-dd8f-44c4-b610-f9112cbb6e5c

	measure 'DTC Receipt U' =
			CALCULATE(
			 sum(InTransit[ReceiptUnits]),
			 InTransit[Channel]="DTC")
		formatString: 0
		lineageTag: da22366b-716b-4261-b79f-4bcec7f668b4

	measure 'Wholesale Receipt U' =
			CALCULATE(
			 sum(InTransit[ReceiptUnits]),
			 InTransit[Channel]="Wholesale")
		formatString: 0
		lineageTag: 5bc86054-7567-4262-9ecf-4c4e798d1005

	measure 'Intransit U LY' = ```
			
			VAR LastDayAvailable = max('Date'[Date])+ if(max('Date'[Date])>=today(),WEEKDAY(today(), 1)-8,0)
			VAR LastDayLY=LOOKUPVALUE('Date EOY'[Date LY],'Date EOY'[Date],LastDayAvailable)
			VAR LY=CALCULATETABLE(SUMMARIZECOLUMNS('Date EOY'[Date LY], FILTER('Date EOY','Date EOY'[Year]=max('Date EOY'[Year]))),ALLEXCEPT('Date EOY','Date EOY'[Select a Calendar]))
			Return
			CALCULATE (
			   sum(InTransit[IntransitUnits]),
			   ALLEXCEPT('Date EOY', 'Date EOY'[Select a Calendar]),
			    'Date EOY'[Date] in LY &&
			    'Date EOY'[Date]<=LastDayLY  
			)
			```
		formatString: #,0
		lineageTag: faa69075-862a-4013-aced-6787cc4f38bc

	measure 'Intransit Cost LY' = ```
			
			VAR LastDayAvailable = max('Date'[Date])+ if(max('Date'[Date])>=today(),WEEKDAY(today(), 1)-8,0)
			VAR LastDayLY=LOOKUPVALUE('Date EOY'[Date LY],'Date EOY'[Date],LastDayAvailable)
			VAR LY=CALCULATETABLE(SUMMARIZECOLUMNS('Date EOY'[Date LY], FILTER('Date EOY','Date EOY'[Year]=max('Date EOY'[Year]))),ALLEXCEPT('Date EOY','Date EOY'[Select a Calendar]))
			Return
			CALCULATE (
			   sum(InTransit[IntransitCost]),
			   ALLEXCEPT('Date EOY', 'Date EOY'[Select a Calendar]),
			    'Date EOY'[Date] in LY &&
			    'Date EOY'[Date]<=LastDayLY  
			)
			```
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: dc022fd8-9122-4b36-9c0d-30019b70f2e7

	measure 'Intransit C vs LY %' = ([Intransit Cost TY]-[Intransit Cost LY])/[Intransit Cost LY]
		formatString: 0.0%;(0.0%)
		lineageTag: 28de79e3-0e63-45d4-a452-9aeb768d2e2d

		annotation PBI_FormatHint = {"isCustom":true}

	measure 'Intransit Cost TY' = ```
			
			VAR LastDateAvailable=min(LASTDATE('Date'[Date]),LASTDATE('Date EOY'[Date]))
			VAR YearTY=CALCULATE(max('Date EOY'[Year]),'Date EOY'[Date]=LastDateAvailable)    //2025
			Return
			CALCULATE (
			   sum(InTransit[IntransitCost]),
			  ALLEXCEPT('Date EOY', 'Date EOY'[Select a Calendar]),
			    'Date EOY'[Date]<=LastDateAvailable,
			     'Date EOY'[Year] = YearTY
			)
			
			```
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: 900e7988-2301-4724-85ca-996ddf682d0d

	column Column1
