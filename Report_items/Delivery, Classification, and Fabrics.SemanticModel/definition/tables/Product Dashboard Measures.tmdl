			            )
			        )=1
			    )
			),
			CALCULATE([Shipments ST% LY Delivery],
			    FILTER(RankingDimension,
			        RANKX(ALL('Product (Current)'[Material Clone]),round([Ranking Measure LY Delivery],0), ,DESC)<RankLimit
			    )
			)
			)
		formatString: 0.0%;(0.0%);0.0%
		displayFolder: Rank\Fabric\Shipments ST%
		lineageTag: 8de7d5e1-a695-4f11-a87e-870474ea316d

		annotation PBI_FormatHint = {"isCustom":true}

	measure 'Rank Receipt ST% TY-Fabric' =
			
