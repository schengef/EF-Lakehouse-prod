	measure 'Weeks On Hand TY' =
			
			VAR LastFiscalWeek = LOOKUPVALUE('Date'[Week End Date],'Date'[DateKey],MAX('Filter Dates'[DateKey]),'Date'[Select a Calendar],SELECTEDVALUE('Date'[Select a Calendar] ))
			VAR LastFiscalYear = LOOKUPVALUE('Date'[Year],'Date'[DateKey],MAX('Filter Dates'[DateKey]),'Date'[Select a Calendar],SELECTEDVALUE('Date'[Select a Calendar] ))
			RETURN
			DIVIDE(
			    [External Quantity On Hand],
			    DIVIDE(
			        CALCULATE(
			            [External Retail Sales Units],
			            ALLEXCEPT('Date','Date'[Select a Calendar]),
			            'Date'[Year]=LastFiscalYear,
			            DATESINPERIOD('Date'[Week End Date],LastFiscalWeek,-28,DAY),
			    KEEPFILTERS('Product (Current)'[Division Description Mi9]<>"MISCELLANEOUS")
			        ),4 //Rolling average of the last 4 weeks
			    )
			)
		formatString: 0.0;(0.0)
		displayFolder: On Hand\Weeks
		lineageTag: 41292d3b-6627-4324-9311-0ceac663d3e2

		annotation PBI_FormatHint = {"isCustom":true}

	measure 'Weeks On Hand LY' =
			
			VAR LastDayAvailable = LOOKUPVALUE('Date'[Week End Date],'Date'[DateKey],MAX('Filter Dates'[DateKey]),'Date'[Select a Calendar],SELECTEDVALUE('Date'[Select a Calendar] ))
			VAR LastDayLY=LOOKUPVALUE('Date'[Date LY],'Date'[Date],LastDayAvailable)
			VAR RollingPeriod=CALCULATETABLE(SUMMARIZECOLUMNS('Date'[Date LY], DATESINPERIOD('Date'[Week End Date],LastDayAvailable,-28,DAY)),ALLEXCEPT('Date','Date'[Select a Calendar]))
			RETURN
			DIVIDE(
			    CALCULATE(
			    [External Quantity On Hand],
			    ALLEXCEPT('Date', 'Date'[Select a Calendar]),
			    'Date'[Date]<=LastDayLY,
			    KEEPFILTERS('Product (Current)'[Division Description Mi9]<>"MISCELLANEOUS")
			    ),
			    DIVIDE(
			        CALCULATE(
			            [External Retail Sales Units],
			            ALLEXCEPT('Date','Date'[Select a Calendar]),
			            'Date'[Date] in RollingPeriod,
			    KEEPFILTERS('Product (Current)'[Division Description Mi9]<>"MISCELLANEOUS")
			        ),4 //Rolling average of the last 4 weeks
			    )
			)
		formatString: " 0.0;(0.0)"
		displayFolder: On Hand\Weeks
		lineageTag: 2c90a295-9dec-45a5-b0b1-d1b4bde71c77

		annotation PBI_FormatHint = {"isCustom":true}

