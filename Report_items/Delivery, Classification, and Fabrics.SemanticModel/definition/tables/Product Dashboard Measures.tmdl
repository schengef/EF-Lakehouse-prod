	measure 'Shipments $ TY' = ```
			
			VAR LastFiscalYear = LOOKUPVALUE('Date'[Year],'Date'[DateKey],MAX('Filter Dates'[DateKey]),'Date'[Select a Calendar],SELECTEDVALUE('Date'[Select a Calendar] ))
			VAR LastFiscalMonth = LOOKUPVALUE('Date'[Monthnum],'Date'[DateKey],MAX('Filter Dates'[DateKey]),'Date'[Select a Calendar],SELECTEDVALUE('Date'[Select a Calendar] ))
			VAR LastFiscalWeek = LOOKUPVALUE('Date'[Week End Date],'Date'[DateKey],MAX('Filter Dates'[DateKey]),'Date'[Select a Calendar],SELECTEDVALUE('Date'[Select a Calendar] ))
			     
			Return
