table 'Product Dashboard Measures'
	lineageTag: 8e83b861-fb95-4a9b-bb49-3481193e2310

	measure 'Net Sales $ TY' = ```
			
			VAR LastFiscalYear = LOOKUPVALUE('Date'[Year],'Date'[DateKey],MAX('Filter Dates'[DateKey]),'Date'[Select a Calendar],SELECTEDVALUE('Date'[Select a Calendar] ))
			VAR LastFiscalMonth = LOOKUPVALUE('Date'[Monthnum],'Date'[DateKey],MAX('Filter Dates'[DateKey]),'Date'[Select a Calendar],SELECTEDVALUE('Date'[Select a Calendar] ))
			VAR LastFiscalWeek = LOOKUPVALUE('Date'[Week End Date],'Date'[DateKey],MAX('Filter Dates'[DateKey]),'Date'[Select a Calendar],SELECTEDVALUE('Date'[Select a Calendar] ))
			     
			Return
			IF(
			    SELECTEDVALUE('Headers-Period'[Period])="LTD",
			    CALCULATE([External Retail Sales $],
			    ALL('Date'),
			    KEEPFILTERS('Product (Current)'[Division Description Mi9]<>"MISCELLANEOUS")
			    ),
			    CALCULATE (
			        [External Retail Sales $],
			        ALLEXCEPT('Date','Date'[Select a Calendar]),
			        SWITCH(
			            SELECTEDVALUE('Headers-Period'[Period]),
			            "WTD",'Date'[Year] = LastFiscalYear && 'Date'[Week End Date]=LastFiscalWeek, 
			            "MTD", 'Date'[Year] = LastFiscalYear  && 'Date'[Monthnum]=LastFiscalMonth && 'Date'[Week End Date]<=LastFiscalWeek,
			            "YTD",'Date'[Year] = LastFiscalYear && 'Date'[Week End Date]<=LastFiscalWeek
			        ),
			    KEEPFILTERS('Product (Current)'[Division Description Mi9]<>"MISCELLANEOUS")
			    )
			)
			```
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Net Retail Sales $
		lineageTag: ba7f30db-5fa5-43ec-ad15-b2c37e6a17d6

	measure 'Net Sales $ LY' = ```
			
			VAR LastDayAvailable = max('Date'[Week End Date])
			VAR LastDayLY=LOOKUPVALUE('Date'[Date LY],'Date'[Date],LastDayAvailable)
			VAR LastWeek=max('Date'[Week End Date])
			VAR LastYear=max('Date'[Year])
			VAR LY=CALCULATETABLE(SUMMARIZECOLUMNS('Date'[Date LY], FILTER('Date','Date'[Year]=LastYear)),ALLEXCEPT('Date','Date'[Select a Calendar]))
			VAR LastMonth=LOOKUPVALUE('Date'[Monthnum],'Date'[Date],LastDayAvailable,'Date'[Select a Calendar],SELECTEDVALUE('Date'[Select a Calendar]))
			VAR LM=CALCULATETABLE(SUMMARIZECOLUMNS('Date'[Date LY], FILTER('Date','Date'[Monthnum]=LastMonth)),ALLEXCEPT('Date','Date'[Select a Calendar]))
			VAR LW=CALCULATETABLE(SUMMARIZECOLUMNS('Date'[Date LY], FILTER('Date','Date'[Week End Date]=LastWeek)),ALLEXCEPT('Date','Date'[Select a Calendar]))    
			Return
			CALCULATE (
			    [External Retail Sales $],
			    ALLEXCEPT('Date', 'Date'[Select a Calendar]),
			    SWITCH(
			        SELECTEDVALUE('Headers-Period'[Period]),
			        "WTD", 'Date'[Date] in LW && 'Date'[Date]<=LastDayLY,
			        "MTD", 'Date'[Date] in LM && 'Date'[Date] in LY && 'Date'[Date]<=LastDayLY,
			        "YTD",'Date'[Date] in LY && 'Date'[Date]<=LastDayLY,
			        "LTD",'Date'[Date]<=LastDayLY
			    ),
			    KEEPFILTERS('Product (Current)'[Division Description Mi9]<>"MISCELLANEOUS")
			)
			```
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Net Retail Sales $
		lineageTag: 913e010a-288e-4ee0-938a-60db2b9e31be

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

