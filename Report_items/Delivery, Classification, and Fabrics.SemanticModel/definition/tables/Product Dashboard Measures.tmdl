	measure 'Rank Sales AUR LY-Fabric' =
			
			VAR RankingDimension=VALUES('Product (Current)'[Material Clone])
			VAR RankLimit=COUNTROWS(Ranking)
			RETURN
			if(ISINSCOPE('Ranking'[Rank]),
			CALCULATE([Net Sales $ AUR LY],
			    FILTER(RankingDimension,
			        COUNTROWS(
			            FILTER('Ranking',
			                RANKX(ALL('Product (Current)'[Material Clone]),round([Ranking Measure LY],0), ,DESC)=SELECTEDVALUE('Ranking'[Rank])
			            )
			        )=1
			    )
			),
			CALCULATE([Net Sales $ AUR LY],
			    FILTER(RankingDimension,
			        RANKX(ALL('Product (Current)'[Material Clone]),round([Ranking Measure LY],0), ,DESC)<=RankLimit
			    )
			)
			)
