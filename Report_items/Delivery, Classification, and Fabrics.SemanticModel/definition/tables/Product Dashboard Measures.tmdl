			        'Date'[Date]<=LastDayLY,
			        ALLEXCEPT('Delivery','Delivery'[Delivery Month]),
			        'Delivery'[Delivery Year]=format(IFERROR(VALUE(SELECTEDVALUE('Delivery'[Delivery Year])),0)-1,"####"),
			        KEEPFILTERS('Product (Current)'[Division Description Mi9]<>"MISCELLANEOUS")
