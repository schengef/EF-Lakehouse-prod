	measure 'Is Current Season' = ```
			
			VAR SeasonShort=IF(LOOKUPVALUE('Date'[MonthNum],'Date'[Date],MAX('Date'[Date]),'Date'[Select a Calendar],SELECTEDVALUE('Date'[Select a Calendar]))<7,"S","F")
			VAR SeasonLong=IF(SeasonShort="S","Spring","Fall")
			VAR YearLong=LOOKUPVALUE('Date'[Year],'Date'[Date],MAX('Date'[Date]),'Date'[Select a Calendar],SELECTEDVALUE('Date'[Select a Calendar]))
			VAR YearShort=RIGHT(YearLong,2)
			RETURN 
			SeasonShort&YearShort&"-"&SeasonLong&" "&YearLong
			```
		displayFolder: Returns
		lineageTag: 82b74579-f695-4473-9564-8c173cc9119c

		changedProperty = Name

	measure 'Remove Empty Rows Delivery Year Month' =
			
			VAR BaseMonth=format(MAX('Date'[Date]),"mm")
			VAR BaseYear=FORMAT(MAX('Date'[Date]),"yy")
			VAR NexMonth=if(DAY(Max('Date'[Date]))<12,BaseMonth,SWITCH(BaseMonth,"12","01",format(VALUE(BaseMonth+1),"00")))
			VAR NexYear=if(DAY(Max('Date'[Date]))<12,BaseYear,SWITCH(BaseMonth,"12",format(value(BaseYear+1),"00"),BaseYear))
			VAR DeliveryCodeKey=LOOKUPVALUE(Delivery[Delivery Code Key],Delivery[Delivery Code],NexYear&NexMonth)
			RETURN
			DeliveryCodeKey-SELECTEDVALUE('Delivery'[Delivery Code Key])
		formatString: 0
		displayFolder: Delivery\Formatting
		lineageTag: e2150722-3fd0-4dd0-bddd-e90f9569624f

	measure 'Net Sales $ LY Delivery' = ```
			
			VAR LastDayAvailable = max('Date'[Week End Date])
			VAR LastDayLY=LOOKUPVALUE('Date'[Date LY],'Date'[Date],LastDayAvailable)
			VAR LastWeek=max('Date'[Week End Date])
			VAR LastYear=max('Date'[Year])
			VAR LY=CALCULATETABLE(SUMMARIZECOLUMNS('Date'[Date LY], FILTER('Date','Date'[Year]=LastYear)),ALLEXCEPT('Date','Date'[Select a Calendar]))
			VAR LastMonth=LOOKUPVALUE('Date'[Monthnum],'Date'[Date],LastDayAvailable,'Date'[Select a Calendar],SELECTEDVALUE('Date'[Select a Calendar]))
			VAR LM=CALCULATETABLE(SUMMARIZECOLUMNS('Date'[Date LY], FILTER('Date','Date'[Monthnum]=LastMonth)),ALLEXCEPT('Date','Date'[Select a Calendar]))
			VAR LW=CALCULATETABLE(SUMMARIZECOLUMNS('Date'[Date LY], FILTER('Date','Date'[Week End Date]=LastWeek)),ALLEXCEPT('Date','Date'[Select a Calendar]))  
			Return
			IF(
			    OR(ISFILTERED(Delivery[Season]),ISFILTERED(Delivery[Delivery Month])),
			    IF(
			        SELECTEDVALUE('Headers-Period'[Period])="LTD",
			        CALCULATE (
			        [External Retail Sales $],
			        ALL('Date'),
			        'Date'[Date]<=LastDayLY,
			        ALLEXCEPT('Delivery','Delivery'[Delivery Month]),
			        'Delivery'[Delivery Year]=format(IFERROR(VALUE(SELECTEDVALUE('Delivery'[Delivery Year])),0)-1,"####"),
			        KEEPFILTERS('Product (Current)'[Division Description Mi9]<>"MISCELLANEOUS")
			        ),
			        CALCULATE (
			            [External Retail Sales $],
			            ALLEXCEPT('Delivery','Delivery'[Delivery Month]),
			            ALLEXCEPT('Date', 'Date'[Select a Calendar]),
			            'Delivery'[Delivery Year]=format(IFERROR(VALUE(SELECTEDVALUE('Delivery'[Delivery Year])),0)-1,"####"),
			            SWITCH(
			                SELECTEDVALUE('Headers-Period'[Period]),
			                "WTD", 'Date'[Date] in LW && 'Date'[Date]<=LastDayLY,
			                "MTD", 'Date'[Date] in LM && 'Date'[Date] in LY && 'Date'[Date]<=LastDayLY,
			                "YTD",'Date'[Date] in LY && 'Date'[Date]<=LastDayLY,
			                "LTD",'Date'[Date]<=LastDayLY
			            ),
			            KEEPFILTERS('Product (Current)'[Division Description Mi9]<>"MISCELLANEOUS")
			        )
			    ),
			    [Net Sales $ LY]
			)
			```
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Delivery\Net Retail Sales $
		lineageTag: 49e5bbcb-8d58-423e-af2e-a3b858c12b45

