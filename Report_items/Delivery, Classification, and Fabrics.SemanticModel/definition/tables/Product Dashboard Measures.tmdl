			    "Net Gross Margin %",format([Net Gross Margin % TY],"0.0%;(0.0%)"),
			    "Net Retail Sales $ AUR",format([Net Sales $ AUR TY],"$#,###;($#,###)"),
			    "Retail $ On Hand AUR",format([On Hand AUR $ TY],"$#,###;($#,###)"),
			    "Cost $ On Hand",if(SELECTEDVALUE('Headers-Units/Dollars'[Selection])="Dollars",format([Cost OH $ TY],"$#,###;($#,###);")),
			    "Units On Hand",if(SELECTEDVALUE('Headers-Units/Dollars'[Selection])="Units",format([Units OH TY],"#,###;(#,###);")),
			    "Weeks On Hand Units",format([Weeks On Hand TY],"0.0;(0.0)"),
			    "FP 
			% to Total Apparel",format([Net Sales FP % TY],"0.0%;(0.0%)"),
