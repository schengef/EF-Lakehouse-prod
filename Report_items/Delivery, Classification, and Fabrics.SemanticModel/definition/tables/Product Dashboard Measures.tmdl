		lineageTag: 5ed35328-2f09-4c72-b54d-9f1ce8e12be7

		formatStringDefinition = ```
				if(SELECTEDVALUE('Headers-Units/Dollars'[Selection])="Dollars","$#,###;($#,###)","#,###;(#,###)")
				
				```

		changedProperty = Name

	measure 'Rank Shipments TY-Fabric' =
			
			VAR RankingDimension=VALUES('Product (Current)'[Material Clone])
			VAR RankLimit=COUNTROWS(Ranking)
			RETURN
			if(ISINSCOPE('Ranking'[Rank]),
			CALCULATE([Display Shipments TY],
			    FILTER(RankingDimension,
			        COUNTROWS(
			            FILTER('Ranking',
			                RANKX(ALL('Product (Current)'[Material Clone]),round([Ranking Measure TY],0), ,DESC)=SELECTEDVALUE('Ranking'[Rank])
			            )
			        )=1
			    )
			),
			CALCULATE([Display Shipments TY],
			    FILTER(RankingDimension,
			        RANKX(ALL('Product (Current)'[Material Clone]),round([Ranking Measure TY],0), ,DESC)<=RankLimit
			    )
			)
			)
		displayFolder: Rank\Fabric\Shipments
		lineageTag: c8b380a7-635f-47b4-b18e-cca44bda541c

		formatStringDefinition = ```
				if(SELECTEDVALUE('Headers-Units/Dollars'[Selection])="Dollars","$#,###;($#,###)","#,###;(#,###)")
				
				```

	measure 'Rank Recpeits % vs LY Delivery-Fabric' =
			
			DIVIDE(
			    [Rank Shipments TY-Fabric]-[Rank Shipments LY Delivery-Fabric],
			    [Rank Shipments LY Delivery-Fabric]
			)
		formatString: 0.0%;(0.0%);0.0%
		displayFolder: Rank\Fabric\Shipments
		lineageTag: 533a8c38-918c-4b7c-9c3d-4981769691e4

		annotation PBI_FormatHint = {"isCustom":true}

	measure 'Rank Receipt ST% LY Delivery-Fabric' =
			
			VAR RankingDimension=VALUES('Product (Current)'[Material Clone])
			VAR RankLimit=COUNTROWS(Ranking)
			RETURN
			if(ISINSCOPE('Ranking'[Rank]),
