	measure 'Units OH LY BOP Delivery' =
			
			VAR LastFiscalYear = LOOKUPVALUE('Date'[Year],'Date'[DateKey],MAX('Filter Dates'[DateKey]),'Date'[Select a Calendar],SELECTEDVALUE('Date'[Select a Calendar] ))
			VAR LastFiscalMonth = LOOKUPVALUE('Date'[Monthnum],'Date'[DateKey],MAX('Filter Dates'[DateKey]),'Date'[Select a Calendar],SELECTEDVALUE('Date'[Select a Calendar] ))
			VAR LastFiscalWeek = LOOKUPVALUE('Date'[Week],'Date'[DateKey],MAX('Filter Dates'[DateKey]),'Date'[Select a Calendar],SELECTEDVALUE('Date'[Select a Calendar] ))
			
			RETURN
			CALCULATE(
			    [External Quantity On Hand],
			    'Delivery'[Delivery Year]=format(LastFiscalYear-1,"####"),
			    ALLEXCEPT('Delivery','Delivery'[Delivery Month]),
			    SWITCH(
			        SELECTEDVALUE('Headers-Period'[Period]),
			        "WTD",'Date'[week]=LastFiscalWeek-1 && 'Date'[Year]=LastFiscalYear-1,
			        "MTD",'Date'[Monthnum]=LastFiscalMonth-1 && 'Date'[Year]=LastFiscalYear-1,
			        "YTD",'Date'[Year]=LastFiscalYear-1 && 'Date'[Dayofyear]=7,
			        'Date'[Week End Date]=MIN('Date'[Week End Date])
			    ),
			    KEEPFILTERS('Product (Current)'[Division Description Mi9]<>"MISCELLANEOUS")
			)
		displayFolder: Delivery\Sell Thru
		lineageTag: e4852b0a-16c4-45d4-87f3-d657b53a7e77

