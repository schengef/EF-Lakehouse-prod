	measure 'Sales by Rank  LY Delivery-Color' =
			
			VAR RankingDimension=VALUES('Product (Current)'[Color Description])
			VAR RankLimit=COUNTROWS(Ranking)
			RETURN
			if(ISINSCOPE('Ranking'[Rank]),
			CALCULATE([Ranking Measure LY Delivery],
			    FILTER(RankingDimension,
			        COUNTROWS(
			            FILTER('Ranking',
			                RANKX(ALL('Product (Current)'[Color Description]),round([Ranking Measure LY Delivery],0), ,DESC)=SELECTEDVALUE('Ranking'[Rank])
			            )
			        )=1
			    )
			),
			CALCULATE([Ranking Measure LY Delivery],
			    FILTER(RankingDimension,
			        RANKX(ALL('Product (Current)'[Color Description]),round([Ranking Measure LY Delivery],0), ,DESC)<=RankLimit
			    )
			)
			)
