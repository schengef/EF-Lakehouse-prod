	measure 'Display Overall' =
			
			Switch(
			    SELECTEDVALUE('Headers-Detail'[Period]),
			    "TY",[Display TY],
			    "LY",[Display LY],
			    "% vs LY",[Display % vs LY],
			    ".",SWITCH(
			        SELECTEDVALUE('Headers-Units/Dollars'[Selection]),
			        "Dollars",SWITCH(
			            SELECTEDVALUE('Headers-Detail'[Metric]),
			            "Net Sales Units",blank(),
			            "Units On Hand",blank(),
			            " "
			        ),
			        "Units",SWITCH(
			            SELECTEDVALUE('Headers-Detail'[Metric]),
			            "Net Sales $",blank(),
			            "Cost $ On Hand",blank(),
			            " "
			        ),
			        " "
			    )
			)
