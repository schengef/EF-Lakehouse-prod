	/// Total cost sales after returns only from respective Original channel 
	/// [Gross Cost Sales $] - [Cost Returns $]
	measure 'Net Cost Sales $' =
			[Gross Cost Sales $]
			-
			[Cost Returns $]
		formatString: $###,###
		lineageTag: 86c9ee73-aab9-4cdb-a55d-1e8c899b88d1

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Distinct Count of [Transaction ID] where [Original Channel Name]=DTC, [Transaction Type]=ORDER or TAKE
	measure 'Sales Transactions' =
			
			VAR ValidTransactionTypes = {"ORDER", "TAKE"}
			RETURN
			CALCULATE(
			    DISTINCTCOUNT('Transactions (Financial)'[Transaction ID]),
			    'Original Channel (DTC)'[Original Channel Name] = "DTC",
			    'Transactions (Financial)'[Transaction Type] IN ValidTransactionTypes
			    //KEEPFILTERS('Transactions (Financial)'[Dtc Misc Flag]<>1
			)
		lineageTag: 829e9f63-c95d-4575-89a6-ebfe7b20706d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// [Net Sales Units] divided by [Sales Transactions]
	measure UPTs =
			
			DIVIDE(
			[Net Sales Units],
			[Sales Transactions]
			)
		formatString: 0.0
		lineageTag: e7fae1d1-fa6f-4da3-95a1-70cd201d2f72

	/// [Net Retail Sales $]+[Net Retail Orders $] divided by [Sales Transactions] where 'Transactions (Financial)'[Transaction Type] is not "SHIPMENT"
	measure AOV =
			
			CALCULATE(
			    DIVIDE(
			        [Net Retail Sales $]+[Net Retail Orders $],
			        [Sales Transactions]
			        ),
			    'Transactions (Financial)'[Transaction Type]<>"SHIPMENT"
			)
		formatString: $#,##0;($#,,##0)
		lineageTag: 973ad29c-5502-4d59-86a5-36ebd7d5ceed

		annotation PBI_FormatHint = {"isCustom":true}

	/// [Net Retail Sales $]+[Demand Net Retail Sales $] divided by [Net Sales Units]+[Demand Unit Sales]
	measure AUR =
			
			DIVIDE(
			    [Net Retail Sales $]+[Demand Net Retail Sales $],
			    [Net Sales Units]+[Demand Unit Sales]
			)
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: 599f5a1c-f606-4124-9a8a-01f103a56131

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	/// [Net Retail Sales $] where [Mark Type]=FP divided by all [Net Retail Sales $]
	measure 'DTC Full Price %' =
			
			DIVIDE(
			    CALCULATE([Net Retail Sales $],
			    'Transactions (Financial)'[Mark Type]="FP"
			    ),
			    [Net Retail Sales $]
			)
		lineageTag: 71f1f74d-0953-45fa-8070-901f2358f25a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// The sum of [Net Price] where [Channel Name]=DTC, [Channel Format]=Digital, [Original Channel Format]=Digital, [Transaction Type]=RETURN that is not MISC
	measure 'DC Returns Retail (Digital Purchase)' = ```
			
			CALCULATE(
			    [Net Price (Sum)],
			    KEEPFILTERS(Channel[Channel Name]="DTC"),
			    KEEPFILTERS(Channel[Channel Format]="Digital"),
			    KEEPFILTERS('Transactions (Financial)'[Transaction Type]="RETURN"),
			    KEEPFILTERS('Original Channel (DTC)'[Original Channel Format]="Digital"),
			    KEEPFILTERS('Transactions (Financial)'[Dtc Misc Flag]<>1)
			)
			
			```
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Returns
		lineageTag: e11180f5-3ea2-4ac1-bb63-cbdf3e7c8e03

	/// Sum of [Net Price] where [Channel Name]=DTC, [Channel Format]=Stores, [Original Channel Format]=Digital, [Transaction Type]=RETURN that is not MISC
	measure 'Store Returns Retail (Digital Purchase)' =
			
			CALCULATE(
			    [Net Price (Sum)],
			    KEEPFILTERS(Channel[Channel Name]="DTC"),
			    KEEPFILTERS(Channel[Channel Format]="Stores"),
			    KEEPFILTERS('Transactions (Financial)'[Transaction Type]="RETURN"),
			    KEEPFILTERS('Original Channel (DTC)'[Original Channel Format]="Digital"),
			    KEEPFILTERS('Transactions (Financial)'[Dtc Misc Flag]<>1)
			)
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Returns
		lineageTag: e439ab12-60df-430f-9e5e-120026757c31

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	/// Sum of [Net Price] where [Channel Name]=DTC, [Channel Format]=Stores, [Original Channel Format]=Stores, [Transaction Type]=RETURN that is not MISC
	measure 'Store Returns Retail (Store Purchase)' =
			
			CALCULATE(
			    [Net Price (Sum)],
			    KEEPFILTERS(Channel[Channel Name]="DTC"),
			    KEEPFILTERS(Channel[Channel Format]="Stores"),
			    KEEPFILTERS('Transactions (Financial)'[Transaction Type]="RETURN"),
			    KEEPFILTERS('Original Channel (DTC)'[Original Channel Format]="Stores"),
			    KEEPFILTERS('Transactions (Financial)'[Dtc Misc Flag]<>1)
			)
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Returns
		lineageTag: 5d14f7f0-0972-4d66-b7d9-597c8685ad83

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	/// [Total Price] - [Net Price] where [Channel Geography]=Canada
	measure 'Markdown $ Retail' =
			
			CALCULATE(
			    [Total Price (Sum)]-[Net Price (Sum)],
			    KEEPFILTERS('Channel'[Channel Geography]="Canada")
			    )
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: 9ec97edf-350e-4a1c-ab74-64ffa6f1c88a

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	/// The sum of [Standard Cost] where [Channel Name]=DTC, [Transaction Type]=RETURN that is not MISC
	measure 'Cost Returns $' = ```
			
			CALCULATE(
			    [Standard Cost (Sum)],  
			    KEEPFILTERS(Channel[Channel Name]="DTC"),
			    KEEPFILTERS('Transactions (Financial)'[Transaction Type]="RETURN"),
			    KEEPFILTERS('Transactions (Financial)'[Dtc Misc Flag]<>1)
			)
			```
		displayFolder: Returns
		lineageTag: 6ca226d8-c08b-47ce-a022-22686413d831

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Sum of [Tax Amount] where [Channel Name]=DTC, [Transaction Type]=RETURN that is not MISC
	measure 'Returns Tax $' =
			
			CALCULATE(
			    [Tax Amount (Sum)],
			    KEEPFILTERS(Channel[Channel Name]="DTC"),
			    KEEPFILTERS('Transactions (Financial)'[Transaction Type]="RETURN"),
			    KEEPFILTERS('Transactions (Financial)'[Dtc Misc Flag]<>1)
			)
		displayFolder: Returns
		lineageTag: 09307463-43a3-4115-9905-c88ba12bb43c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Distinct Count of [Transaction ID] where [Channel Name]=DTC
	measure Transactions =
			
			
			CALCULATE(
			    DISTINCTCOUNT('Transactions (Financial)'[Transaction ID]),
			    'Original Channel (DTC)'[Original Channel Name] = "DTC"
			    //KEEPFILTERS('Transactions (Financial)'[Dtc Misc Flag]<>1
			)
		lineageTag: 819149d8-5deb-4742-bcc3-214c41b8777d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Sum of [Net Price] where [Channel Name]=DTC and [Transaction Type]=ORDER
	measure 'Net Retail Orders $' =
			
			CALCULATE(
			    [Net Price (Sum)],
			    KEEPFILTERS(Channel[Channel Name]="DTC"),
			    KEEPFILTERS('Transactions (Financial)'[Transaction Type]="ORDER")
			)
		lineageTag: 863253f9-2aad-4099-89f3-bd3bab107971

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// [Sales Transactions] divided by [Traffic]
	measure Conversions =
			
			DIVIDE(
			    [Sales Transactions],
			    [Traffic]
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: bee887f0-6052-411a-a3fb-4d594f13642e

	measure Traffic =
			
			CALCULATE(
			    SUM(
			        'Traffic'[Visits]
			    )
			)
		formatString: #,0
		lineageTag: ab00bac4-5575-402b-81a3-f356eee84c4b

		annotation PBI_FormatHint = {"isDecimal":true}

	/// Count of unique transactions, aggregated at the Date, Store, and Transaction Type level
	measure 'Sales Transactions Aggregated' =
			
			VAR ValidTransactionTypes = {"ORDER", "TAKE"}
			RETURN
			CALCULATE(
			    SUM('Agg Pseudo-Transaction Count'[Transactions]),
			    'Original Channel (DTC)'[Original Channel Name] = "DTC",
			    'Agg Pseudo-Transaction Count'[Transaction Type] IN ValidTransactionTypes
			    //KEEPFILTERS('Transactions (Financial)'[Dtc Misc Flag]<>1
			)
		formatString: #,0
		lineageTag: ad22fc75-6163-49e9-9463-8d1c27396d0b

	partition 'DTC Measures' = m
		mode: import
		queryGroup: Measures
		source =
				let
				    Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Column1 = _t]),
				    #"Changed Type" = Table.TransformColumnTypes(Source,{{"Column1", type text}}),
				    #"Removed Columns" = Table.RemoveColumns(#"Changed Type",{"Column1"})
				in
				    #"Removed Columns"

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

