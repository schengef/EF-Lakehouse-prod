	/// Total retail sales (before returns )
	/// Sum of [Net Price] where [Channel Name]=DTC, [Transaction Type]=SHIPMENT or TAKE that is not MISC
	measure 'Gross Retail Sales $' = ```
			
			CALCULATE(
			    [Net Price (Sum)],
			    KEEPFILTERS(Channel[Channel Name]="DTC"),        
			    KEEPFILTERS('Transactions (Financial)'[Transaction Type] in {"SHIPMENT","TAKE"}),
			    KEEPFILTERS('Transactions (Financial)'[Dtc Misc Flag]<>1)
			)
			//&& 'Transaction (Internal)'[Channel Key] <> 2020101 && 'Transaction (Internal)'[Channel Key] <> 2020103 && 'Transaction (Internal)'[Channel Key] <> 2030101
			```
		formatString: $###,###
		lineageTag: 729a097b-a0e6-48d3-b712-4c274f35a142

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Total unit sales before (before returns)
	/// Sum of [Units] where [Channel Name]=DTC,  [Transaction Type]=SHIPMENT or TAKE that is not MISC
	measure 'Gross Unit Sales' =
			
			CALCULATE(
			    [Units (Sum)],
			    KEEPFILTERS(Channel[Channel Name]="DTC"),
			    KEEPFILTERS('Transactions (Financial)'[Transaction Type]="SHIPMENT"||'Transactions (Financial)'[Transaction Type]="TAKE"),
			    KEEPFILTERS('Transactions (Financial)'[Dtc Misc Flag]<>1)
			)
		formatString: ###,###
		lineageTag: 4affe5d8-d1e9-4a3e-b6ce-a2817b309984

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Total cost sales (before returns)
	/// Sum of [Standard Cost] where [Channel Name]=DTC, [Transaction Type]=SHIPMENT or TAKE that is not MISC
	measure 'Gross Cost Sales $' =
			
			CALCULATE(
			   [Standard Cost (Sum)],
			    KEEPFILTERS(Channel[Channel Name]="DTC"),
			    KEEPFILTERS('Transactions (Financial)'[Transaction Type]="SHIPMENT"||'Transactions (Financial)'[Transaction Type]="TAKE")  ,
			    KEEPFILTERS('Transactions (Financial)'[Dtc Misc Flag]<>1)
			    //'Transactions (Financial)'[Channel Key] <> 2020101 && 'Transactions (Financial)'[Channel Key] <> 2020103 && 'Transactions (Financial)'[Channel Key] <> 2030101
			)
		formatString: $###,###
		lineageTag: 27170ffa-1562-4490-9b63-1cd9632ddbf4

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Gross retail margin $ (before returns)
	/// [Gross Retail Sales $]-[Gross Cost Sales $]
	measure 'Gross Margin $' =
			
			[Gross Retail Sales $]
			-
			[Gross Cost Sales $]
		formatString: $###,###
		lineageTag: 2123c1b2-0af6-4c2c-b97c-f5282503eb46

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Gross retail margin % (before returns)
	/// [Gross Margin $] divided by [Gross Retail Sales $]
	measure 'Gross Margin %' =
			
			DIVIDE(
			    [Gross Margin $],
			    [Gross Retail Sales $]
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 948fefb4-d419-41ab-8dec-355442a546ae

	/// Average unit retail (before returns)
	/// [Gross Retail Sales $] divided by [Gross Unit Sales]
	measure 'Gross Sales AUR' =
			
			DIVIDE(
			    [Gross Retail Sales $],
			    [Gross Unit Sales]
			)
		formatString: $###,###
		lineageTag: 056c0d06-d2cf-49d9-87a2-8f6f70d89977

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Average unit cost (before returns)
	/// [Gross Cost Sales $] divided by [Gross Unit Sales]
	measure 'Gross Sales AUC' =
			
			DIVIDE(
			    [Gross Cost Sales $],
			    [Gross Unit Sales]
			)
		formatString: $###,###
		lineageTag: d8e0e885-d0a9-4679-9e9c-7f09ba0f3a75

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Gross margin $ after returns from respective channel
	/// [Net Retail Sales $] - [Net Cost Sales $]
	measure 'Net Gross Margin $' =
			
			[Net Retail Sales $]
			-
