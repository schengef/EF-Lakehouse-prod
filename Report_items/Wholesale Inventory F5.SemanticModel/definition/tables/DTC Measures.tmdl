table 'DTC Measures'
	lineageTag: 67ba48f5-45a6-4375-af24-f8bf3f9e0289

	/// Customer orders on Web in retail $s before discount
	/// Sum of [Total Price] where [Channel Name]=DTC, [Channel Format]=Digital, [Transaction Type]=ORDER
	measure 'Demand Gross Retail Sales $' =
			
			CALCULATE(
			    [Total Price (Sum)],
			    KEEPFILTERS(Channel[Channel Name]="DTC"),
			    KEEPFILTERS(Channel[Channel Format]="Digital"),
			    KEEPFILTERS('Transactions (Financial)'[Transaction Type]="ORDER")
			)
		formatString: $#,###
		lineageTag: a02f08da-8cb5-4ec6-a9aa-dbc07e1efebe
		dataCategory: Uncategorized

		annotation PBI_FormatHint = {"isCustom":true}

	/// Retail $ Discount amount on Web Gross Retail Sales $
	/// Sum of [Discount Amount] where [Channel Name]=DTC, [Channel Format]=Digital, [Transaction Type]=ORDER
	measure 'Demand Discount Retail Sales $' =
			
			CALCULATE(
			    [Discount Amount (Sum)],
			    KEEPFILTERS(Channel[Channel Name]="DTC"),
			    KEEPFILTERS(Channel[Channel Format]="Digital"),
			    KEEPFILTERS('Transactions (Financial)'[Transaction Type]="ORDER")
			)
		formatString: $###,###
		lineageTag: 06dda1fa-87b9-44be-83be-dbde6a78dcda

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Customer orders on Web in retail $s after discount
	/// Sum of [Net Price] where [Channel Name]=DTC, [Channel Format]=Digital, [Transaction Type]=ORDER
	measure 'Demand Net Retail Sales $' =
			
			CALCULATE(
			    [Net Price (Sum)],
			    KEEPFILTERS(Channel[Channel Name]="DTC"),
			    KEEPFILTERS(Channel[Channel Format]="Digital"),
			    KEEPFILTERS('Transactions (Financial)'[Transaction Type]="ORDER")
			)
		formatString: $###,###
		lineageTag: 3243fbe1-478d-4181-a1bb-3de73e1490f8

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Customer web units sold
	/// Sum of [Units] where [Channel Name]=DTC, [Channel Format]=Digital, [Transaction Type]=ORDER
	measure 'Demand Unit Sales' =
			
			CALCULATE(
			    [Units (Sum)],
			    Channel[Channel Name]="DTC",
			    Channel[Channel Format]="Digital",
			    'Transactions (Financial)'[Transaction Type]="ORDER"
			)
		formatString: ###,###
