expression 'DirectQuery to AS - Lakehouse Semantic Model' =
		let
		    Source = AnalysisServices.Database("powerbi://api.powerbi.com/v1.0/myorg/Lakehouse", "Lakehouse Semantic Model"),
		    Cubes = Table.Combine(Source[Data]),
		    Cube = Cubes{[Id="Model", Kind="Cube"]}[Data]
		in
		    Cube
	lineageTag: 452e78d2-585f-4531-b5f4-3f0c74b3c0ad

	annotation PBI_IncludeFutureArtifacts = True

