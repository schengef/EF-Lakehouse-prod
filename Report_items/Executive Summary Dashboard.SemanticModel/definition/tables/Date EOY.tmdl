	column LastWeek =
			
			VAR CurrentWeek = 'Date EOY'[Week]
			VAR CurrentYear = 'Date EOY'[Year]
			VAR CurrentCalendar = 'Date EOY'[Select a Calendar]
			
			RETURN
			IF (
			    CurrentWeek > 1,
			    CurrentWeek - 1,
			    CALCULATE (
			        MAX ( 'Date EOY'[Week] ),
			        REMOVEFILTERS ( 'Date EOY' ),
			        'Date EOY'[Year] = CurrentYear - 1,
			        'Date EOY'[Select a Calendar] = CurrentCalendar
			    )
			)
		formatString: 0
		lineageTag: f1338bf5-3e8f-4429-b028-28f8fc4aa2ad
		summarizeBy: sum

		changedProperty = Name

		annotation SummarizationSetBy = Automatic

	column LastWeek_Year = ```
			
			VAR CurrentDate = 'Date EOY'[Date]
			VAR CurrentCalendar = 'Date EOY'[Select a Calendar]
			VAR PreviousWeekDate = CurrentDate - 7
			
			RETURN
			LOOKUPVALUE (
			    'Date EOY'[Year],               
			    'Date EOY'[Date],               
			    PreviousWeekDate,               
			    'Date EOY'[Select a Calendar],   
			    CurrentCalendar
			)
			```
		formatString: 0
		lineageTag: f6ee071b-85d6-492b-aab1-d87de76af843
		summarizeBy: sum

		changedProperty = Name

		annotation SummarizationSetBy = Automatic

