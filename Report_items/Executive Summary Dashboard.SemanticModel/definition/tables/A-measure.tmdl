table A-measure
	lineageTag: dc6e990c-8ba9-44b9-ae45-d7bbae5c7200

	measure test =
			
			VAR LastDayAvailable = max('Date'[Date])+ if(max('Date'[Date])>=today(),WEEKDAY(today(), 1)-8,0)   //5/2/2026
			VAR LastDayLY=LOOKUPVALUE('Date'[Date LY],'Date'[Date],LastDayAvailable)    //  5/3/2025
			VAR LY=CALCULATETABLE(SUMMARIZECOLUMNS('Date'[Date LY], FILTER('Date','Date'[Year]=max('Date'[Year]))),ALLEXCEPT('Date','Date'[Select a Calendar]))
			VAR LastMonth=LOOKUPVALUE('Date'[Monthnum],'Date'[Date],LastDayAvailable,'Date'[Select a Calendar],SELECTEDVALUE('Date'[Select a Calendar]))    // 3
			VAR LM=CALCULATETABLE(SUMMARIZECOLUMNS('Date'[Date LY], FILTER('Date','Date'[Monthnum]=LastMonth&&'Date'[Year]=max('Date'[Year])),ALLEXCEPT('Date','Date'[Select a Calendar])))
			Return LastMonth
			// CALCULATE (
			//     [Net External Retail Sales $ MIX],
			//     ALLEXCEPT('Date', 'Date'[Select a Calendar]),
			//     'Date'[Date] in LM &&
			//     'Date'[Date]<=LastDayLY
			// )
		formatString: 0
		lineageTag: 9fbad500-dd8f-44c4-b610-f9112cbb6e5c

	column Column1
		dataType: string
		lineageTag: e7719202-0712-4b3e-823c-68b1074d7394
		summarizeBy: none
		sourceColumn: Column1

		annotation SummarizationSetBy = Automatic

	partition A-measure = m
		mode: import
		source =
				let
				    Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Column1 = _t]),
				    #"Changed Type" = Table.TransformColumnTypes(Source,{{"Column1", type text}})
				in
				    #"Changed Type"

	annotation PBI_ResultType = Table

