	column 'Dashboard Monday Week Offset' =
			
			if(WEEKDAY(TODAY())=2,
			'Date'[Week End Date]=CALCULATE(MAX('Date'[Week End Date]),ALL('Date')),FALSE())
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: 66946555-6e0d-4b7d-b1c4-cae371900a7b
		summarizeBy: none

		changedProperty = Name

		annotation SummarizationSetBy = Automatic

