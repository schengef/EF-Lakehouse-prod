function _DTC_TY_Summary = ```
		(_measure : scalar decimal expr)=>
		VAR Period = SELECTEDVALUE('Headers - DTC'[Period])
		VAR LastDateAvailable = max('Date'[Date])
		VAR LastFiscalYear = MAX('Date'[Year])
		VAR LastFiscalYearMonthAvailable = LOOKUPVALUE('Date'[MonthNum],'Date'[date],LastDateAvailable,'Date'[Select a Calendar],SELECTEDVALUE('Date EOY'[Select a Calendar]) )
		VAR LastFiscalYearWeekAvailable = MAX ( 'Date'[Week End Date] )
		
		VAR Week = 
		    CALCULATE (
		            _measure,
		            ALLEXCEPT('Date EOY', 'Date EOY'[Select a Calendar]),
		            'Date EOY'[Date] <= LastDateAvailable &&  
		            'Date EOY'[Week End Date] = LastFiscalYearWeekAvailable &&
		            'Date EOY'[Year] = LastFiscalYear
		        )
		        
		VAR Month = 
		    CALCULATE (
		            _measure,
		            ALLEXCEPT('Date EOY', 'Date EOY'[Select a Calendar]),
		            'Date EOY'[Date] <= LastDateAvailable &&  
		            'Date EOY'[MonthNum] = LastFiscalYearMonthAvailable &&
		            'Date EOY'[Year] = LastFiscalYear
		        )
		
		VAR Year = 
		    CALCULATE (
		            _measure,
		            ALLEXCEPT('Date EOY', 'Date EOY'[Select a Calendar]),
		            'Date EOY'[Date] <= LastDateAvailable &&  
		            'Date EOY'[Year] = LastFiscalYear
		        )
		   
		Return
		    Switch(
		    Period,
		    "     WTD     ",Week,
		    "     MTD     ",Month,
		    "     YTD     ",Year
		    )
		```
	lineageTag: 992453d7-05b8-42a3-88ff-f8a2a2578a7d

function _DTC_Budget_Summary = ```
		
		(_BudgetName : anyval)=>
		VAR Period = SELECTEDVALUE('Headers - DTC'[Period])
		VAR LastDateAvailable = LASTDATE('Date'[Date]) 
		VAR LastFiscalYear = MAX('Date'[Year])
		VAR LastFiscalYearMonthAvailable = LOOKUPVALUE('Date'[MonthNum],'Date'[date],LastDateAvailable,'Date'[Select a Calendar],SELECTEDVALUE('Date EOY'[Select a Calendar]) )
		VAR LastFiscalYearWeekAvailable = MAX ( 'Date'[Week End Date] )
		
		VAR Week = 
		    CALCULATE (
		            [Budget],
		           KEEPFILTERS(
		                FILTER(
		                    ALL('Budget (Channel)'[Measure], 'Budget (Channel)'[CHANNEL]),
		                    'Budget (Channel)'[Measure] IN _BudgetName && 
		                    'Budget (Channel)'[CHANNEL] = "Digital"
		                )
		            ),
		            ALLEXCEPT('Date EOY', 'Date EOY'[Select a Calendar]),
		            'Date EOY'[Date] <= LastDateAvailable &&  
		            'Date EOY'[Week End Date] = LastFiscalYearWeekAvailable &&
		            'Date EOY'[Year] = LastFiscalYear
		        )
		        
		VAR Month = 
		    CALCULATE (
		            [Budget],
		            KEEPFILTERS(
		                FILTER(
		                    ALL('Budget (Channel)'[Measure], 'Budget (Channel)'[CHANNEL]),
		                    'Budget (Channel)'[Measure] IN _BudgetName && 
		                    'Budget (Channel)'[CHANNEL] = "Digital"
		                )
		            ),
		            ALLEXCEPT('Date EOY', 'Date EOY'[Select a Calendar]),
		            'Date EOY'[Date] <= LastDateAvailable &&  
		            'Date EOY'[MonthNum] = LastFiscalYearMonthAvailable &&
		            'Date EOY'[Year] = LastFiscalYear
		        )
		
		VAR Year = 
		    CALCULATE (
		            [Budget],
		            KEEPFILTERS(
		                FILTER(
		                    ALL('Budget (Channel)'[Measure], 'Budget (Channel)'[CHANNEL]),
		                    'Budget (Channel)'[Measure] IN _BudgetName && 
		                    'Budget (Channel)'[CHANNEL] = "Digital"
		                )
		            ),
		            ALLEXCEPT('Date EOY', 'Date EOY'[Select a Calendar]),
		            'Date EOY'[Date] <= LastDateAvailable &&  
		            'Date EOY'[Year] = LastFiscalYear
		        )
		   
		Return
		    Switch(
		    Period,
		    "     WTD     ",Week,
		    "     MTD     ",Month,
		    "     YTD     ",Year
		    )
		```
	lineageTag: e723f567-c45d-4e9a-992b-c5e7d69968f1

function _DTC_Forecast_Summary = ```
		( _ForecastName : anyval)=>
		VAR Period = SELECTEDVALUE('Headers - DTC'[Period])
		VAR LastDateAvailable = LASTDATE('Date'[Date]) 
		VAR LastFiscalYear = MAX('Date'[Year])
		VAR LastFiscalYearMonthAvailable =LOOKUPVALUE('Date'[MonthNum],'Date'[date],LastDateAvailable,'Date'[Select a Calendar],SELECTEDVALUE('Date EOY'[Select a Calendar]) )
		VAR LastFiscalYearWeekAvailable = MAX ( 'Date'[Week End Date] )
		
		VAR Week = 
		    CALCULATE (
		            [Forecast],
		             KEEPFILTERS(
		                FILTER(
		                    ALL('Forecast (Channel)'[Measure] , 'Forecast (Channel)'[CHANNEL]),
		                    'Forecast (Channel)'[Measure] in _ForecastName && 
		                    'Forecast (Channel)'[CHANNEL]= "Digital"
		                )
		            ),
		            ALLEXCEPT('Date EOY', 'Date EOY'[Select a Calendar]),
		            'Date EOY'[Date] <= LastDateAvailable &&  
