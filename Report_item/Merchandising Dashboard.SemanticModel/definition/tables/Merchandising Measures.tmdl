table 'Merchandising Measures'
	lineageTag: 2e5bc774-e4ea-4e38-b1cd-ec4918f24dd3

	measure 'Display Top 15 Sales $' =
			
			if(
			    SELECTEDVALUE('Headers-Sales/Receipts Top 15'[Selection])="Sales",
			    [Net Sales $ TY],
			    [Shipments $ TY]
			)
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: 2f861295-1075-4be9-af94-0f5ac79c3dfa

	measure 'Display Top 15 Sales Units' =
			
			if(
			    SELECTEDVALUE('Headers-Sales/Receipts Top 15'[Selection])="Sales",
			    [Net Sales Units TY],
			    [Shipments Units TY]
			)
		formatString: #,0
		lineageTag: fedbd6f6-5c19-424b-bc59-11b3dbebd3d9

		annotation PBI_FormatHint = {"isDecimal":true}

	measure 'Display Top 15 ST%' =
			
			if(
			    SELECTEDVALUE('Headers-Sales/Receipts Top 15'[Selection])="Sales",
			    [Sell Through % TY],
			    [Shipments ST% TY]
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: dd496999-25bd-4d93-bbb5-87b24ed863fd

	measure 'Top 15 Ranking Measure' =
			
			CALCULATE(
			if(
			    SELECTEDVALUE('Headers-Units/Dollars'[Selection])="Units",
			    [Display Top 15 Sales Units],
			    [Display Top 15 Sales $]
			),
			ALL(Channel[Channel Name])
			)
		formatString: """ """
		lineageTag: b960ab3c-b155-438e-a6a6-b6b6ccbec69b

		annotation PBI_FormatHint = {"isCustom":true}

	measure 'Net Sales % to Filtered Total TY Subclass' =
			
			DIVIDE(
			    [Display Net Sales TY],
			    CALCULATE (
			        [Display Net Sales TY],
			        ALLSELECTED('Product (Current)'[Style Subclassification]),
			    KEEPFILTERS('Product (Current)'[Division Description Mi9]<>"MISCELLANEOUS")
			    )
			)
		displayFolder: Sales % to Filtered Total
		lineageTag: 4bb8ce23-f058-47cf-a648-a6a563dedc99

		changedProperty = Name

		changedProperty = FormatString

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Remove Empty Rows Delivery Year Merchandising' =
			
			VAR AllSelectedRows=COUNTROWS(ALLSELECTED(Delivery[Season],Delivery[Delivery Month]))
			VAR AllRows=CALCULATE(
			    COUNTROWS(SUMMARIZE(Delivery,Delivery[Season],Delivery[Delivery Month])),
			    ALL(Delivery)
			)
			Return
			IF(
			    AllSelectedRows>AllRows,
			    [Remove Empty Rows Delivery Year Month],
			    1
			)
		lineageTag: 495e57cd-089d-42f8-bb42-19793ec62a61

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Net Sales % to Filtered Total' =
			
			SWITCH(
			    TRUE(),
			    ISFILTERED('Product (Current)'[Armhole Construction]),[Net Sales % to Filtered Total TY Armhole],
			    ISFILTERED('Product (Current)'[Color Category]),[Net Sales % to Filtered Total TY Color Category],
			    ISFILTERED('Product (Current)'[Color Description]),[Net Sales % to Filtered Total TY Color Desc],
			    ISFILTERED('Product (Current)'[Ef Color Family]),[Net Sales % to Filtered Total TY Color Family],
			    ISFILTERED('Product (Current)'[Color Shade]),[Net Sales % to Filtered Total TY Color Shade],
			    ISFILTERED('Product (Current)'[Color Temp]),[Net Sales % to Filtered Total TY Color Temp],
			    ISFILTERED('Product (Current)'[Fit]),[Net Sales % to Filtered Total TY Fit],
			    ISFILTERED('Product (Current)'[Identity Short]),[Net Sales % to Filtered Total TY Identity],
			    ISFILTERED('Product (Current)'[Garment Length]),[Net Sales % to Filtered Total TY Length],
			    ISFILTERED('Product (Current)'[Material Clone]),[Net Sales % to Filtered Total TY Material Clone],
			    ISFILTERED('Product (Current)'[Material Family]),[Net Sales % to Filtered Total TY Material Family],
			    ISFILTERED('Product (Current)'[Material Group]),[Net Sales % to Filtered Total TY Material Group],
			    ISFILTERED('Product (Current)'[Material Classification Description]),[Net Sales % to Filtered Total TY Material Class],
			    ISFILTERED('Product (Current)'[Neckline]),[Net Sales % to Filtered Total TY Neckline],
			    ISFILTERED('Product (Current)'[Neckline Type]),[Net Sales % to Filtered Total TY Neckline Type],
			    ISFILTERED('Product (Current)'[Price Tier]),[Net Sales % to Filtered Total TY Price Tier],
			    ISFILTERED('Product (Current)'[Sleeve Length]),[Net Sales % to Filtered Total TY Sleeve],
			    ISFILTERED('Product (Current)'[Style Subclassification]),[Net Sales % to Filtered Total TY Subclass],
			    ISFILTERED('Product (Current)'[Waist Construction]),[Net Sales % to Filtered Total TY Waist],
			    ISFILTERED(Delivery[Delivery Month]),[Net Sales % to Filtered Total TY Delivery],
			    1
			)
		formatString: 0%;-0%;0%
		displayFolder: Sales % to Filtered Total
		lineageTag: 4faf7d97-22fb-46d1-b894-e8e403e29c34

	measure 'Net Sales % to Filtered Total TY Material Clone' =
			
