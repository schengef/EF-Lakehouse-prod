	measure 'Remove Empty Rows Delivery' =
			
			VAR CurrMonth=FORMAT(LOOKUPVALUE('Date'[MonthNum],'Date'[Date],MAX('Date'[Date]),'Date'[Select a Calendar],SELECTEDVALUE('Date'[Select a Calendar])),"00")
			VAR CurrYear=right(LOOKUPVALUE('Date'[Year],'Date'[Date],MAX('Date'[Date]),'Date'[Select a Calendar],SELECTEDVALUE('Date'[Select a Calendar])),2)
			VAR DeliveryCodeKey=LOOKUPVALUE(Delivery[Delivery Code Key],Delivery[Delivery Code],CurrYear&CurrMonth)
			RETURN
			DeliveryCodeKey-SELECTEDVALUE('Delivery'[Delivery Code Key])
		lineageTag: e70660a4-e745-49be-9712-5ba61590397f

