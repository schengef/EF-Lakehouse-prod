table 'Channel Calc Group'
	lineageTag: 0faad3a5-62de-4244-bc01-54ff36e37ee9

	calculationGroup
		precedence: 3

		calculationItem '        TY        ' =
				
				VAR LastDayAvailable = max('Date'[Date])+ if([Max Date]>=today(),WEEKDAY(today(), 1)-8,0)
				RETURN
				if(ISINSCOPE('Date'[Date]),blank(),
				CALCULATE(
				[Daily Flash TY],
				'Date'[Date]<=LastDayAvailable
				)
				)

			formatStringDefinition = "$#,###;($#,###)"

		calculationItem '        LY        ' =
				
				if(ISINSCOPE('Date'[Date]),blank(),
				    VAR LastDayAvailable = max('Date'[Date])+ if([Max Date]>=today(),WEEKDAY(today(), 1)-8,0)
				    VAR LastDayLY=max('Date'[Date])
				    VAR LW=SUMMARIZECOLUMNS('Date'[Date], FILTER('Date','Date'[Week End Date]=max('Date'[Week End Date])))
				    Return
				        CALCULATE (
				                [Daily Flash LY],
				                ALLEXCEPT('Date', 'Date'[Select a Calendar]),
				                'Date'[Date] in LW &&
				                'Date'[Date]<=LastDayAvailable
				            )
				)

			formatStringDefinition = "$#,###;($#,###)"

		calculationItem '    % vs LY    ' =
				
				if(ISINSCOPE('Date'[Date]),blank(),
				    VAR LastDayAvailable = max('Date'[Date])+ if([Max Date]>=today(),WEEKDAY(today(), 1)-8,0)
				    VAR LastDayLY=max('Date'[Date])
				    VAR LW=SUMMARIZECOLUMNS('Date'[Date], FILTER('Date','Date'[Week End Date]=max('Date'[Week End Date])))
				    Return
				        CALCULATE (
				                format([Daily Flash % vs LY],"0.0%;(0.0%)"),
				                ALLEXCEPT('Date', 'Date'[Select a Calendar]),
				                'Date'[Date] in LW &&
				                'Date'[Date]<=LastDayAvailable
				            )
				)

			formatStringDefinition = "0.0%;(0.0%)"

		calculationItem '   Budget   ' =
				
				if(ISINSCOPE('Date'[Date]),blank(),
				[Daily Flash Budget]
				)

			formatStringDefinition = "$#,###;($#,###)"

		calculationItem '% vs Budget' = ```
				
				if(ISINSCOPE('Date'[Date]),blank(),
				format([Daily Flash % vs Budget],"0.0%;(0.0%)")
				)
				
				```

			formatStringDefinition = "0.0%;(0.0%)"

		calculationItem '% of Budget in' = ```
				
				if(ISINSCOPE('Date'[Date]),blank(),
				format(1+[Daily Flash % vs Budget],"0.0%;(0.0%)")
				)
				
				```

			formatStringDefinition = "0.0%;(0.0%)"

		calculationItem Daily = ```
				
				if(ISINSCOPE('Date'[Date]),
				        SWITCH(SELECTEDVALUE('Header-Daily Flash'[Measure]),
				        "      TY      ",[Daily Flash TY],
				        "      LY      ",[Daily Flash LY],
				        "   % vs LY   ",format([Daily Flash % vs LY],"0.0%;(0.0%)")
				        ),
				    blank()
				)
				
				
				```

			formatStringDefinition = "$#,###;($#,###)"

	column 'Calculation group column'
		dataType: string
		lineageTag: a6ea66cd-44e1-4d9b-9130-987d3831beac
		summarizeBy: none
		sourceColumn: Name
		sortByColumn: Ordinal

		annotation SummarizationSetBy = Automatic

	column Ordinal
		dataType: int64
		formatString: 0
		lineageTag: ec79b48a-66ec-4d2a-8854-298a09e9c1bf
		summarizeBy: sum
		sourceColumn: Ordinal

		annotation SummarizationSetBy = Automatic

