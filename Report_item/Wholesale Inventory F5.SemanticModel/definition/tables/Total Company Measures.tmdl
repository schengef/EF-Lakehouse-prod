	/// [External Retail Sales Units] divided by [External Retail Sales Units] + [External Quantity On Hand]
	measure 'External Sell Through %' =
			
			DIVIDE(
			    [External Retail Sales Units],
			    [External Retail Sales Units]+[External Quantity On Hand]
			)
		formatString: #,0%;-#,0%;#,0%
		lineageTag: 34e3f296-0dca-4b67-9100-8fb6265ce4db

	/// [External Retail Sales $] where [Mark Type]=FP divided by all [External Retail Sales $]
	measure 'Overall External Full Price %' =
			
			DIVIDE(
			    CALCULATE([External Retail Sales $],
			    'Transactions (External POS)'[Mark Type]="FP"
			    ),
			    [External Retail Sales $]
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 3993f03c-e56a-423a-8413-651ceed67096

