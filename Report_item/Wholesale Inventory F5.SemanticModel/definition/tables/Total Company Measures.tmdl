table 'Total Company Measures'
	lineageTag: 1aa2380c-17ee-4101-814c-3687568852be

	/// Sum of [On Hand Cost] POS
	measure 'External Cost $' =
			
			if(
			    SELECTEDVALUE('Currency Selector'[Currency Selection])="Local",
			    SUM('Transactions (External POS)'[On Hand Cost]),
			    VAR AggregatedInCurrency=
			    ADDCOLUMNS(
			        SUMMARIZE(
			            'Transactions (External POS)',
			            'Transactions (External POS)'[Currency Key]
			        ),
			        "@NetPrice",calculate( sum('Transactions (External POS)'[On Hand Cost])),
			        "@Rate",LOOKUPVALUE('Currency Pivot'[Conversion Value],'Currency Pivot'[Currency Key],'Transactions (External POS)'[Currency Key]),
			        "@DefaultRate",LOOKUPVALUE('Currency Pivot'[Conversion Value],'Currency Pivot'[Currency Key],'Transactions (External POS)'[Currency Key],'Currency Pivot'[Conversion Type],"BUDGET_TO_USD")
			    )  //Creates a table summing dollars by date with the currently selected and default conversion rate for that date
			    VAR Result=
			    IF (
			        HASONEVALUE ( 'Currency Selector'[Currency Selection] ),
			        SUMX (
			            AggregatedInCurrency,
			            [@NetPrice]*[@Rate]
			            ),
			            SUMX (
			            AggregatedInCurrency,
			            [@NetPrice]*[@DefaultRate]
			            )
			    )
			    RETURN
			    Result
			)
		isHidden
		lineageTag: 9e19e568-68ac-43cd-81e7-255d0e89d08b

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isGeneralNumber":true}

