table 'Wholesale Measures'
	lineageTag: 61903b3d-cb76-4e41-8c05-5de73f66b8ba

	/// Total gross wholesale cost, shipments at the full price, demand net cancellations
	/// Sum of [Total Price] where [Channel]=Wholesale, [Transaction Type]=SHIPMENT that is not an internal EF account
	measure 'Gross Sales $' = ```
			
			VAR EFAccounts={"EF102","EF702","EF777","EF150","EF111","EF302","EF799"}
			RETURN
			CALCULATE(
			    [Total Price (Sum)],
			    KEEPFILTERS(Channel[Channel Name]="Wholesale"),        
			    KEEPFILTERS('Transactions (Financial)'[Transaction Type]="SHIPMENT"),
			    KEEPFILTERS(NOT('Accounts'[Account Code] in EFAccounts))
			)
			```
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: 84ce05ef-6386-4e4d-9f98-1258110d296f

	/// Credit issued
	/// Sum of [Total Price] where [Channel]=Wholesale], [Transaction Type]=CREDIT that is not an internal EF account
	measure 'Gross Return (RTV) $' = ```
			
			VAR EFAccounts={"EF102","EF702","EF777","EF150","EF111","EF302","EF799"}
			RETURN
			CALCULATE(
			    [Total Price (Sum)],
			    KEEPFILTERS(Channel[Channel Name]="Wholesale"),        
			    KEEPFILTERS('Transactions (Financial)'[Transaction Type]="CREDIT"),
			    KEEPFILTERS(NOT('Accounts'[Account Code] in EFAccounts))
			)
			```
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: e5b3501a-c849-4982-a4ed-9860d9d28789

	/// Sum of [Discount Amount] where [Channel Name]=Wholesale, [Transaction Type]=SHIPMENT that is not an EF internal account
	measure 'Upfront Discount on Sales $' = ```
			
