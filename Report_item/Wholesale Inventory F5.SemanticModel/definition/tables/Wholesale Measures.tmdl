		lineageTag: b97bb2a3-7b9f-4fc3-b739-62469656105d

	/// Sum of [Discount Amount] where [Channel Name]=Wholesale, [Transaction Type]=CREDIT that is not an EF internal account
	measure 'Upfront Discount on Return $' = ```
			
