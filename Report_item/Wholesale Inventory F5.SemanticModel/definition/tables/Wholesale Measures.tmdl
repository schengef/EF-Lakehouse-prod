	///     [EOP External $ On Hand POS] divided by
	///     [EOP External Units On Hand POS]
	measure 'AUR External Stock POS' =
			
			DIVIDE(
			    [EOP External $ On Hand POS],
			    [EOP External Units On Hand POS]
			)
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: External\POS
		lineageTag: a1f3709c-3a5a-4c23-a3b7-5d89133a9655

	/// Sum of [Oh Dollars] FIN at the maximum date in the view
	measure 'EOP External $ On Hand FIN' =
			
			if(
			    SELECTEDVALUE('Currency Selector'[Currency Selection])="Local",
			    CALCULATE(
			        SUM('Transactions (Account FIN)'[Oh Dollars]),
			        Inventory[Date Key]=max(Inventory[Date Key])
			    ),
			    VAR AggregatedInCurrency=
			    ADDCOLUMNS(
			        SUMMARIZE(
			            'Transactions (Account FIN)',
			            'Transactions (Account FIN)'[Currency Key]
			        ),
			        "@NetPrice",calculate( sum('Transactions (Account FIN)'[Oh Dollars])),
			        "@Rate",LOOKUPVALUE('Currency Pivot'[Conversion Value],'Currency Pivot'[Currency Key],'Transactions (Account FIN)'[Currency Key]),
			        "@DefaultRate",LOOKUPVALUE('Currency Pivot'[Conversion Value],'Currency Pivot'[Currency Key],'Transactions (Account FIN)'[Currency Key],'Currency Pivot'[Conversion Type],"BUDGET_TO_USD")
			    )
			    VAR Result=
			    IF (
			    HASONEVALUE ( 'Currency Selector'[Currency Selection] ),
			        CALCULATE(
			            SUMX (
			            AggregatedInCurrency,
			            [@NetPrice]*[@Rate]
			            ),
			            Inventory[Date Key]=max(Inventory[Date Key])
			            ),
			        CALCULATE(
			            SUMX (
			            AggregatedInCurrency,
			            [@NetPrice]*[@DefaultRate]
			            ),
			            Inventory[Date Key]=max(Inventory[Date Key])
			            )
			    )
			    RETURN
			    Result
			)
		displayFolder: External\FIN
		lineageTag: f4778810-9b7c-4afd-a450-4043931c8f94

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Sum of [Oh Units] POS at the maximum date in the view
	measure 'EOP External Units On Hand POS' =
			
			CALCULATE(SUM('Transactions (Account POS)'[Oh Units]),
			    Inventory[Date Key]=max(Inventory[Date Key])
			)
		formatString: 0
		displayFolder: External\POS
		lineageTag: 512cda9d-a14b-441d-a163-2b79fc891d2f

		annotation PBI_FormatHint = {"isDecimal":true}

	/// Sum of [Sales Dollars] FIN
	measure 'Net External Retail Sales $ FIN' =
			
			if(
			    SELECTEDVALUE('Currency Selector'[Currency Selection])="Local",
			    //If the selected currency is Local, just sum the field - potential to be summing USD and CAD together.
			    SUM('Transactions (Account FIN)'[Sales Dollars]),
			    VAR AggregatedInCurrency=
			    ADDCOLUMNS(
			        SUMMARIZE(
			            'Transactions (Account FIN)',
			            'Transactions (Account FIN)'[Currency Key]
			        ),
			        "@NetPrice",calculate(SUM('Transactions (Account FIN)'[Sales Dollars])),
			        "@Rate",LOOKUPVALUE('Currency Pivot'[Conversion Value],'Currency Pivot'[Currency Key],'Transactions (Account FIN)'[Currency Key]),
			        "@DefaultRate",LOOKUPVALUE('Currency Pivot'[Conversion Value],'Currency Pivot'[Currency Key],'Transactions (Account FIN)'[Currency Key],'Currency Pivot'[Conversion Type],"BUDGET_TO_USD")
			    )//Creates a table summing dollars by date with the currently selected and default conversion rate for that date
			    VAR Result=
			    IF (
			        HASONEVALUE ( 'Currency Selector'[Currency Selection] ),
			        SUMX(
			            AggregatedInCurrency,
			            [@NetPrice]*[@Rate]
			        ),//If a currency is selected, multiply the daily sales by the daily conversion rate in the temporary table
			        SUMX(
			            AggregatedInCurrency,
			            [@NetPrice]*[@DefaultRate]
			        )//If no currency is selected, multiply the daily sales by the default (USD Budget) daily conversion rate in the temporary table
			    )
			    RETURN
			    Result
			)
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: External\FIN
		lineageTag: d7244c37-5bd9-4d96-bbbc-a028a543330f

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	/// Sum of [Sales Units] POS
	measure 'Net External Retail Sales Units POS' =
			
