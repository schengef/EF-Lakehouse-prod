		lineageTag: dd7e4864-25bf-4171-834c-cfe03c6674f8

	measure 'Wholesale Order Qty' =
			
			VAR EFAccounts={"EF102","EF702","EF777","EF150","EF111","EF302","EF799"}
			RETURN
			CALCULATE(
			    [Units (Sum)],
			    KEEPFILTERS(Channel[Channel Name]="Wholesale"),
			    KEEPFILTERS('Transactions (Financial)'[Transaction Type]= "ORDER"),
			    KEEPFILTERS(NOT('Accounts'[Account Code] in EFAccounts))
			)
		formatString: ###,###
		isHidden
		lineageTag: bc46f9d9-a5ee-49a2-b24f-9351edde4ede

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// [Net Invoiced Sales $] where [Mark Type]=FP divided by all [Net Invoiced Sales $]
	measure 'Wholesale Full Price % (Internal)' =
			
			DIVIDE(
			    CALCULATE([Net Invoiced Sales $],
			    KEEPFILTERS('Transactions (Financial)'[Mark Type]="FP")
			    ),
			    [Net Invoiced Sales $]
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 61cd2d86-83a4-4064-b671-f1ba0c770aaa

	/// Sum of [Quantity] where [Channel Name]=Wholesale not in EF internal accounts.
	/// [Transaction Type]=SHIPMENT - [Transaction Type]=CREDIT
	measure 'Net Units' =
			
			VAR EFAccounts={"EF102","EF702","EF777","EF150","EF111","EF302","EF799"}
			RETURN
			CALCULATE(
			    CALCULATE(
			        [Units (Sum)],
			        KEEPFILTERS('Transactions (Financial)'[Transaction Type]="SHIPMENT")
			    )
			    -
			    CALCULATE(
			        [Units (Sum)],
			        KEEPFILTERS('Transactions (Financial)'[Transaction Type]="CREDIT")
			    ),
			    KEEPFILTERS(NOT('Accounts'[Account Code] in EFAccounts)),
			    KEEPFILTERS(Channel[Channel Name]="Wholesale")
			)
		lineageTag: 920706b8-35c1-4f8c-959c-277f0c73af94

		annotation PBI_FormatHint = {"isGeneralNumber":true}

