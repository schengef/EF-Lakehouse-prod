model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

queryGroup Calendars

	annotation PBI_QueryGroupOrder = 0

queryGroup Currency

	annotation PBI_QueryGroupOrder = 2

queryGroup Facts

	annotation PBI_QueryGroupOrder = 3

queryGroup Dimensions

	annotation PBI_QueryGroupOrder = 4

queryGroup Measures

	annotation PBI_QueryGroupOrder = 9

queryGroup Parameters

	annotation PBI_QueryGroupOrder = 10

queryGroup 'Join Tables'

	annotation PBI_QueryGroupOrder = 11

queryGroup Facts\Aggregated

	annotation PBI_QueryGroupOrder = 0

annotation PBI_QueryOrder = ["DTC Measures","Wholesale Measures","Transactions (Account POS)","Transactions (Account MIX)","Transactions (Account FIN)","Transactions (Financial)","Transactions (External POS)","Traffic","Inventory","Forecast (Channel)","Product","Product (Current)","SnowflakeWarehouse","Environment","Budget (Channel)","Budget (Inventory)","Plan (Wholesale Retail)","Account Group Join","Store","Currency Selector","Accounts","Channel","Delivery","Currency Pivot","Order Type Join","Date","Agg-Transactions (Financial)-$/Day (DTC Focus)","Agg-Transactions (Financial)-$/Day (Wholesale Focus)","Agg-Inventory-Date","Agg-Transactions (External POS)-Day/Product","Agg-Transactions (Financial)-Day/Product","Agg-Transactions (Account MIX)-$/Day","Agg-Traffic-Day/Channel","Agg Pseudo-Transaction Count","Budget (DTC-Store)","Order Categorization","Original Channel (DTC)","Forecast (DTC-Store)","Semantic Model Update","Original Store (DTC)","Budget and Forecast Measures","Inventory Measures","Total Company Measures","Allocated Store (DTC)","Allocated Channel (DTC)","Agg-Transactions (External POS)-Day/Store","Agg-Transactions (Account POS)-Day/Store"]

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["CalcGroup","DaxQueryView_Desktop"]

annotation __TEdtr = 1

