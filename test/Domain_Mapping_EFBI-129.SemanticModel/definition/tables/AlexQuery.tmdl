		annotation PBI_FormatHint = {"isGeneralNumber":true}

	partition AlexQuery = m
		mode: import
		source = ```
				let
				
				    Source = Snowflake.Databases("eileen.us-east-1.snowflakecomputing.com","REPORTING_PROD_WH"),
				    EDW_PROD_Database = Source{[Name="EDW_PROD",Kind="Database"]}[Data],
				    SQLStatement = 
				    "
				SELECT
				    R.REPORT_NAME, BD.BUSINESS_DOMAIN, BD.BUSINESS_SUBDOMAIN, BD.WAREHOUSE_TABLE ,RD.REPORT_KEY 
				FROM EDW_PROD.EDW_T.D_REPORT R
				LEFT JOIN EDW_PROD.EDW_T.B_REPORT_DEPENDENCY RD ON RD.REPORT_KEY = R.REPORT_KEY
				LEFT JOIN EDW_PROD.EDW_T.D_BUSINESS_DOMAIN BD ON RD.BUSINESS_DOMAIN_KEY = BD.BUSINESS_DOMAIN_KEY
				ORDER BY R.REPORT_NAME, BD.BUSINESS_DOMAIN, BD.BUSINESS_SUBDOMAIN
				
				
				
				    ",
				    NativeQuery = Value.NativeQuery(EDW_PROD_Database, SQLStatement, null, [EnableFolding=true])
				in
				    #"NativeQuery"
				```

	annotation PBI_NavigationStepName = Navigation

