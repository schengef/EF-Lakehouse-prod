	measure Blank = BLANK()
		formatString: 0
		lineageTag: 120b9296-40b2-41a4-91f8-4949b25bf843

		changedProperty = Name

	measure 'Max Date' =
			
			MAX('Date'[Date])
		formatString: General Date
		displayFolder: Headers
		lineageTag: 08d4241a-57c4-493a-ae74-026fd80c036a

	measure 'Daily Flash TY' =
			
			if(SELECTEDVALUE('Date'[Date])>=TODAY(),blank(),
			            [Net Retail Sales $]
			)
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Daily Flash
		lineageTag: b8e6333e-1843-40f3-b844-d7656bb18ff3

	measure 'Daily Flash LY' =
			
			VAR LastDayAvailable = max('Date'[Date])+ if([Max Date]>=today(),WEEKDAY(today(), 1)-8,0)
			VAR EndofWeek=max('Date'[Date])
			VAR LastDayLY=LOOKUPVALUE('Date'[Date LY],'Date'[Date],LastDayAvailable)
			VAR EndofWeekLY=LOOKUPVALUE('Date'[Date LY],'Date'[Date],Endofweek)
			VAR LY=CALCULATETABLE(SUMMARIZECOLUMNS('Date'[Date LY], FILTER('Date','Date'[Year]=max('Date'[Year]))),ALLEXCEPT('Date','Date'[Select a Calendar]))
			VAR LW=SUMMARIZECOLUMNS('Date'[Date LY], FILTER('Date','Date'[Week End Date]=max('Date'[Week End Date])))
			RETURN
			IF(ISINSCOPE('Date'[Date]),
			    CALCULATE (
			            [Net Retail Sales $],
			            ALLEXCEPT('Date', 'Date'[Select a Calendar]),
			            'Date'[Date] in LW &&
			            'Date'[Date]<=EndofWeek
			        ),
			    CALCULATE (
			            [Net Retail Sales $],
			            ALLEXCEPT('Date', 'Date'[Select a Calendar]),
			            'Date'[Date] in LW &&
			            'Date'[Date]<=LastDayLY
			        )
			    )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Daily Flash
		lineageTag: 3d64556a-553b-45ef-bda1-fc945cee7c2b

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Daily Flash % vs LY' =
			
			if(ISBLANK([Daily Flash TY]),blank(),
			    DIVIDE(
			        [Daily Flash TY]-[Daily Flash LY],
			        [Daily Flash LY]
			    )
			)
		formatString: 0.0%;(0.0%);0.0%
		displayFolder: Daily Flash
		lineageTag: a40ee9bc-3cb1-4c9c-83cc-4c7503fd60be

		annotation PBI_FormatHint = {"isCustom":true}

	measure 'Daily Flash Budget' = ```
			
			VAR LastDateAvailable = LASTDATE('Date'[Date]) 
			VAR LastFiscalYear = MAX('Date'[Year])
			VAR LastFiscalYearWeekAvailable = MAX ( 'Date'[CurrWeek End Date] )
			
			RETURN 
			if(ISINSCOPE('Date'[Date]),blank(),
			if(ISBLANK([Daily Flash TY]),blank(),
			    CALCULATE (
			            [Net Sales Budget],
			            ALLEXCEPT('Date', 'Date'[Select a Calendar], 'Date'[Week End Date]),
			            'Date'[Date] <= LastDateAvailable &&  
			            'Date'[CurrWeek End Date] = LastFiscalYearWeekAvailable &&
			            'Date'[Year] = LastFiscalYear
			        )
			)
			)
			```
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Daily Flash
		lineageTag: f2d0c1fa-3217-4f4c-a54e-0c4126054997

	measure 'Daily Flash % vs Budget' =
			
			DIVIDE(
			    [Daily Flash TY]-[Daily Flash Budget],
			    [Daily Flash Budget]
			)
		formatString: 0.0%;(0.0%);0.0%
		displayFolder: Daily Flash
		lineageTag: a8381397-4d95-44c3-a18c-a8ec3e011147

		annotation PBI_FormatHint = {"isCustom":true}

	measure 'Daily Flash Digital TY' =
			
			if(SELECTEDVALUE('Date'[Date])>=TODAY(),blank(),
			    SwitcH(
			        SELECTEDVALUE('Header-Digital Detail'[Metric]),
			        "Returns (at DC)",[DC Returns Retail (Digital Purchase)],
			        "Returns (at Stores)",[Store Returns Retail (Digital Purchase)],
			        "SFS Sales",[Daily Flash SFS],
			        "Borderfree",[Daily Flash Borderfree],
			        "Digital Demand",[Demand Gross Retail Sales $]
			    )
			)
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Daily Flash\Digital
		lineageTag: 86a96521-2134-419d-ad6f-74468feb096d

	measure 'Daily Flash Digital Budget' =
			
			VAR LastFiscalYear = MAX('Date'[Year])
			VAR LastFiscalYearWeekAvailable = MAX ( 'Date'[CurrWeek End Date] )
			VAR LastFiscalDOW=max('Date'[DayOfYear])
			RETURN
			if(SELECTEDVALUE('Date'[Date])>=today(),blank(),
			    CALCULATE (
			            SwitcH(
			                SELECTEDVALUE('Header-Digital Detail'[Metric]),
			                "Returns (at DC)",[DC Returns Budget],
			                "Returns (at Stores)",[Store Returns Budget],
			                "SFS Sales",blank(),
			                "Borderfree",blank(),
			                "Digital Demand",[Gross Demand Budget]
			            ),
			            ALLEXCEPT('Date', 'Date'[Select a Calendar], 'Date'[CurrWeek End Date]),
			            'Date'[DayOfYear]<=LastFiscalDOW &&
			            'Date'[CurrWeek End Date] = LastFiscalYearWeekAvailable &&
			            'Date'[Year] = LastFiscalYear
			        )
			)
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Daily Flash\Digital
		lineageTag: 614286ff-79d2-45d4-9343-e0ea7cbf7740

	measure 'Daily Flash Digital % vs Budget' =
			
