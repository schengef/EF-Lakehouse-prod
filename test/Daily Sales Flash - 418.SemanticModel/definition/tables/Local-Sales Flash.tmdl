	measure 'Sales Flash Budget Stores' = ```
			
			VAR Period = SELECTEDVALUE('Header-Sales Flash'[Period])
			VAR LastDateAvailable = LASTDATE('Date'[Date]) 
			VAR LastFiscalYear = MAX('Date'[Year])
			VAR LastFiscalYearMonthAvailable = LOOKUPVALUE('Date'[MonthNum],'Date'[Date],LastDateAvailable,'Date'[Select a Calendar],SELECTEDVALUE('Date'[Select a Calendar]))
			VAR LastFiscalYearWeekAvailable = LOOKUPVALUE('Date'[Week End Date],'Date'[Date],LastDateAvailable,'Date'[Select a Calendar],SELECTEDVALUE('Date'[Select a Calendar]))
			
			VAR Week = 
			    CALCULATE (
			            [Net Sales Budget Stores],
			            ALLEXCEPT('Date', 'Date'[Select a Calendar], 'Date'[Week End Date]),
			            'Date'[Date] <= LastDateAvailable &&  
			            'Date'[Week End Date] = LastFiscalYearWeekAvailable &&
			            'Date'[Year] = LastFiscalYear
			        )
			        
			VAR Month = 
			    CALCULATE (
			            [Net Sales Budget Stores],
			            ALLEXCEPT('Date', 'Date'[Select a Calendar]),
			            'Date'[Date] <= LastDateAvailable &&  
			            'Date'[MonthNum] = LastFiscalYearMonthAvailable &&
			            'Date'[Year] = LastFiscalYear
			        )
			
			VAR Year = 
			    CALCULATE (
			            [Net Sales Budget Stores],
			            ALLEXCEPT('Date', 'Date'[Select a Calendar]),
			            'Date'[Date] <= LastDateAvailable &&  
			            'Date'[Year] = LastFiscalYear
			        )
			   
			Return
			    Switch(
			    Period,
			    "WTD",Week,
			    "MTD",Month,
			    "YTD",Year
			    )
			```
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Budget
		lineageTag: 7d55364d-ffbb-47b7-a419-dc852a844eae

