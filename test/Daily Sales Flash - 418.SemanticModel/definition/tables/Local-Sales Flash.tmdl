table 'Local-Sales Flash'
	lineageTag: 50374c68-17fd-46ed-91c2-4f093541e389

	measure 'Net Sales Budget' = ```
			
			   CALCULATE(
			    [Budget],KEEPFILTERS('Budget (Channel)'[Measure]= "Net Retail Sales $"))
			```
		displayFolder: Budget
		lineageTag: dd58f665-d4ce-402c-8a56-76cbd1ac0b38

		changedProperty = DisplayFolder

	measure 'Sales Flash TY' = ```
			
			VAR Period = SELECTEDVALUE('Header-Sales Flash'[Period])
			VAR LastDateAvailable = max('Date'[Date])+ if([Max Date]>=today(),WEEKDAY(today(), 1)-8,0)
			VAR LastFiscalYear = MAX('Date'[Year])
			VAR LastFiscalYearMonthAvailable = LOOKUPVALUE('Date'[Monthnum],'Date'[Date],LastDateAvailable,'Date'[Select a Calendar],SELECTEDVALUE('Date'[Select a Calendar]))
			VAR LastFiscalYearWeekAvailable = MAX ( 'Date'[Week End Date] )
			
			VAR Week = 
			    CALCULATE (
			            [Net Retail Sales $],
			            ALLEXCEPT('Date', 'Date'[Select a Calendar], 'Date'[Week End Date]),
			            'Date'[Date] <= LastDateAvailable &&  
			            'Date'[Week End Date] = LastFiscalYearWeekAvailable &&
			            'Date'[Year] = LastFiscalYear
			        )
			        
			VAR Month = 
			    CALCULATE (
			            [Net Retail Sales $],
			            ALLEXCEPT('Date', 'Date'[Select a Calendar]),
			            'Date'[Date] <= LastDateAvailable &&  
			            'Date'[MonthNum] = LastFiscalYearMonthAvailable &&
			            'Date'[Year] = LastFiscalYear
			        )
			
			VAR Year = 
			    CALCULATE (
			            [Net Retail Sales $],
			            ALLEXCEPT('Date', 'Date'[Select a Calendar]),
			            'Date'[Date] <= LastDateAvailable &&  
			            'Date'[Year] = LastFiscalYear
			        )
			   
			Return
			    Switch(
			    Period,
			    "WTD",Week,
			    "MTD",Month,
			    "YTD",Year
			    )
			```
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Sales Flash
		lineageTag: 7673b5a9-6751-4891-87ba-bb9ececadd5b

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Sales Flash LY' = ```
			
			VAR Period = SELECTEDVALUE('Header-Sales Flash'[Period])
			VAR LastDayAvailable = max('Date'[Date])+ if([Max Date]>=today(),WEEKDAY(today(), 1)-8,0)
			VAR LastDayLY=LOOKUPVALUE('Date'[Date LY],'Date'[Date],LastDayAvailable)
			VAR LastYear=LOOKUPVALUE('Date'[Year],'Date'[Date],LastDayLY,'Date'[Select a Calendar],SELECTEDVALUE('Date'[Select a Calendar]))
			VAR LY=CALCULATETABLE(SUMMARIZECOLUMNS('Date'[Date], FILTER('Date','Date'[Year]=LastYear)),ALLEXCEPT('Date','Date'[Select a Calendar]))
			VAR LastMonth=LOOKUPVALUE('Date'[Monthnum],'Date'[Date],LastDayAvailable,'Date'[Select a Calendar],SELECTEDVALUE('Date'[Select a Calendar]))
			VAR LM=CALCULATETABLE(SUMMARIZECOLUMNS('Date'[Date LY], FILTER('Date','Date'[Monthnum]=LastMonth)),ALLEXCEPT('Date','Date'[Select a Calendar]))
			VAR LW=SUMMARIZECOLUMNS('Date'[Date LY], FILTER('Date','Date'[Week End Date]=max('Date'[Week End Date])))
			
			VAR Week = 
			    CALCULATE (
			            [Net Retail Sales $],
			            ALLEXCEPT('Date', 'Date'[Select a Calendar]),
			            'Date'[Date] in LW &&
			            'Date'[Date]<=LastDayLY
			        )
			        
			VAR Month = 
			    CALCULATE (
			            [Net Retail Sales $],
			            ALLEXCEPT('Date', 'Date'[Select a Calendar]),
			            'Date'[Date] in LM &&
			            'Date'[Date] in LY &&
			            'Date'[Date]<=LastDayLY
			        )
			
			VAR Year = 
			    CALCULATE (
			            [Net Retail Sales $],
			            ALLEXCEPT('Date', 'Date'[Select a Calendar]),
			            'Date'[Date] in LY &&
			            'Date'[Date]<=LastDayLY
			        )
			   
			Return
			    Switch(
			        Period,
			        "WTD",Week,
			        "MTD",Month,
			        "YTD",Year
			    )
			```
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Sales Flash
		lineageTag: 7732f945-9fb0-49c9-9d17-88c7ec702910

	measure 'Sales Flash Budget' = ```
			
			VAR Period = SELECTEDVALUE('Header-Sales Flash'[Period])
			VAR LastDateAvailable = LASTDATE('Date'[Date]) 
			VAR LastFiscalYear = MAX('Date'[Year])
			VAR LastFiscalYearMonthAvailable = LOOKUPVALUE('Date'[Monthnum],'Date'[Date],LastDateAvailable,'Date'[Select a Calendar],SELECTEDVALUE('Date'[Select a Calendar]))
			VAR LastFiscalYearWeekAvailable = MAX ( 'Date'[Week End Date] )
			
			VAR Week = 
			    CALCULATE (
			            [Net Sales Budget],
			            ALLEXCEPT('Date', 'Date'[Select a Calendar], 'Date'[Week End Date]),
			            'Date'[Date] <= LastDateAvailable &&  
			            'Date'[Week End Date] = LastFiscalYearWeekAvailable &&
			            'Date'[Year] = LastFiscalYear
			        )
			        
			VAR Month = 
			    CALCULATE (
			            [Net Sales Budget],
			            ALLEXCEPT('Date', 'Date'[Select a Calendar]),
			            'Date'[Date] <= LastDateAvailable &&  
			            'Date'[MonthNum] = LastFiscalYearMonthAvailable &&
			            'Date'[Year] = LastFiscalYear
			        )
			
			VAR Year = 
			    CALCULATE (
			            [Net Sales Budget],
			            ALLEXCEPT('Date', 'Date'[Select a Calendar]),
			            'Date'[Date] <= LastDateAvailable &&  
			            'Date'[Year] = LastFiscalYear
			        )
			   
			Return
			    Switch(
			    Period,
			    "WTD",Week,
			    "MTD",Month,
			    "YTD",Year
			    )
			```
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Sales Flash
		lineageTag: f1aac2eb-094f-4f07-8c0d-4845059963aa

