	measure Transactions =
			
			CALCULATE(
			    COUNTROWS(
			        SUMMARIZE(
			            'Transactions (Financial)',
			            'Transactions (Financial)'[Transaction No],
			            'Transactions (Financial)'[Store Id],
			            'Transactions (Financial)'[Register Num],
			            'Transactions (Financial)'[Transaction Date Key]
			        )
			    ),
			    'Channel (DTC Original)'[Original Channel Name] = "DTC"
			)
		formatString: #,0
		lineageTag: 7c74e978-f3d6-4db1-8561-2e6393504a9e

		changedProperty = FormatString

	measure 'Receipt Retail $ MSRP' = ```
			CALCULATE(
			    SUMX(
			        'Inventory Movement', 
			        'Inventory Movement'[Retail Price] * 'Inventory Movement'[Units]
			    ),
			    'Inventory Movement'[Movement Stage] = "RECEIPT",'Inventory Movement'[Movement Type]="PURCHASE ORDER"
			)
			```
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: 34c36ba7-6387-4721-af9a-1ade474aa957

		changedProperty = Name

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Receipt Cost $' = ```
			CALCULATE(
			    SUMX(
			        'Inventory Movement', 
			        'Inventory Movement'[Standard Cost] * 'Inventory Movement'[Units]
			    ),
			    'Inventory Movement'[Movement Stage] = "RECEIPT",
			    'Inventory Movement'[Movement Type]="PURCHASE ORDER"
			)
