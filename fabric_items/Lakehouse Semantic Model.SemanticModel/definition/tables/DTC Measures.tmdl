	measure 'Receipt $ Budget(sum)' =
			
			if(
			    SELECTEDVALUE('Currency Selector'[Currency Selection])="Local",
			    SUM('Budget (Channel)'[Budget Value]),
			    VAR AggregatedInCurrency=
			    ADDCOLUMNS(
			        SUMMARIZE(
			            'Budget (Channel)',
			            'Budget (Channel)'[Currency Key]
			        ),
			        "@NetPrice",calculate( sum('Budget (Channel)'[Budget Value])),
			        "@Rate",LOOKUPVALUE('Currency'[Conversion Value],'Currency'[Currency Key],'Budget (Channel)'[Currency Key],'Currency'[Conversion Type],selectedvalue('Currency'[Conversion Type])),
			        "@DefaultRate",LOOKUPVALUE('Currency'[Conversion Value],'Currency'[Currency Key],'Budget (Channel)'[Currency Key],'Currency'[Conversion Type],"BUDGET_TO_USD")
			    )  //Creates a table summing dollars by date with the currently selected and default conversion rate for that date
			    VAR Result=
			    IF (
			        HASONEVALUE ( 'Currency Selector'[Currency Selection] ),
			        SUMX (
			            AggregatedInCurrency,
			            [@NetPrice]*[@Rate]
			            ),
			            SUMX (
			            AggregatedInCurrency,
			            [@NetPrice]*[@DefaultRate]
			            )
			    )
			    RETURN
			    Result
			)
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: da8a5da9-2809-4f15-baa8-78ca01ef4f8e

		changedProperty = Name

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

