	measure 'Gross Unit Sales' =
			CALCULATE(
			    [Units (Sum)],
			    KEEPFILTERS(Channel[Channel Name]="DTC"),
			    KEEPFILTERS('Transactions (Financial)'[Transaction Type]="SHIPMENT"||'Transactions (Financial)'[Transaction Type]="TAKE"),
			    KEEPFILTERS('Transactions (Financial)'[Dtc Misc Flag]<>1)
			)
		formatString: #,0
		lineageTag: 47276505-555e-482c-9eed-403ef070fb17

		changedProperty = FormatString

	measure 'Gross Cost Sales $' =
			CALCULATE(
			   [Standard Cost (Sum)],
			    KEEPFILTERS(Channel[Channel Name]="DTC"),
			    KEEPFILTERS('Transactions (Financial)'[Transaction Type]="SHIPMENT"||'Transactions (Financial)'[Transaction Type]="TAKE")  ,
			    KEEPFILTERS('Transactions (Financial)'[Dtc Misc Flag]<>1)
			    //'Transactions (Financial)'[Channel Key] <> 2020101 && 'Transactions (Financial)'[Channel Key] <> 2020103 && 'Transactions (Financial)'[Channel Key] <> 2030101
			)
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: 458729d7-6e5b-4fb4-ba83-deb850ba3801

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

