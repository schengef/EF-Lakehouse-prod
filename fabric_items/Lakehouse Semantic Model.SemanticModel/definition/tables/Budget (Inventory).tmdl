table 'Budget (Inventory)'
	lineageTag: b6441e31-74b2-4603-8b9d-34f13fd9df4c
	sourceLineageTag: [dbo].[Budget _Inventory_]

	measure 'Inventory Budget (Sum)' =
			if(
			    SELECTEDVALUE('Currency Selector'[Currency Selection])="Local",
			    SUM('Budget (Inventory)'[Inventory Budget Value]),
			    IF (
			        HASONEVALUE ( 'Currency Selector'[Currency Selection] ),
			            SUMX (
			                'Budget (Inventory)',
			                'Budget (Inventory)'[Inventory Budget Value]*LOOKUPVALUE('Currency'[Conversion Value],'Currency'[Currency Key],'Budget (Inventory)'[Currency Key],'Currency'[Conversion Type],selectedvalue('Currency'[Conversion Type]))
			                )
			    )
			)
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: 5db2daff-cfe1-4dac-ba7b-f7a7f6d481ab

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	column Category
