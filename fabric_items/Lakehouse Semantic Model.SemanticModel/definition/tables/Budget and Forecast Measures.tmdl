table 'Budget and Forecast Measures'
	lineageTag: f42481b9-584b-4284-b3d1-d8836ba0dd13
	sourceLineageTag: [dbo].[Budget and Forecast Measures]

	measure 'Budget Invoiced Gross Margin %' =
			Divide(
			    CALCULATE(
			        [Budget],
			        KEEPFILTERS('Budget (Channel)'[Measure]="Invoiced Gross Margin $")
			    ),
			    CALCULATE(
			        [Budget],
			        KEEPFILTERS('Budget (Channel)'[Measure]="Net Sales $")
			    )
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: f1b6a140-19d5-41c7-922d-ed72c0f7326b

		changedProperty = FormatString

	measure 'Budget Net Gross Margin %' =
			Divide(
			    CALCULATE(
			        [Budget],
			        KEEPFILTERS('Budget (Channel)'[Measure]="Net Gross Margin $")
			    ),
			    CALCULATE(
			        [Budget],
			        KEEPFILTERS('Budget (Channel)'[Measure]="Net Retail Sales $")
			    )
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 9e2a2df7-f755-412b-9e37-35d6492fba5f

		changedProperty = FormatString

	measure 'Budget Net Invoiced Sales $' = ```
			CALCULATE([Budget],KEEPFILTERS('Budget (Channel)'[Measure] = "Gross Sales $")) 
			- 
			CALCULATE([Budget],KEEPFILTERS('Budget (Channel)'[Measure] = "Upfront Discount on Sales $")) 
			+ 
			CALCULATE([Budget],KEEPFILTERS('Budget (Channel)'[Measure] = "Gross Return (RTV) $")) 
			-
			CALCULATE([Budget],FILTER('Budget (Channel)','Budget (Channel)'[Measure]="Dilutions $"),filter('Budget (Channel)','Budget (Channel)'[Order Type]="RTV DISCOUNT OFFSET"))
			```
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: b69a9747-790c-4ba3-bc07-822cb27f78f2

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Forecast Net Gross Margin %' =
			Divide(
			    CALCULATE([Forecast],FILTER('Forecast (Channel)','Forecast (Channel)'[Measure]="Net Gross Margin $"))
			    ,
			    CALCULATE([Forecast],filter('Forecast (Channel)','Forecast (Channel)'[Measure]="Net Retail Sales $"))
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 96363128-04ea-49aa-b9e7-8ae0cee36c21

		changedProperty = FormatString

	measure 'Forecast Net Invoiced Sales $' =
			CALCULATE([Forecast],FILTER('Forecast (Channel)','Forecast (Channel)'[Measure]="Gross Sales $"))
			-
			CALCULATE([Forecast],filter('Forecast (Channel)','Forecast (Channel)'[Measure]="Upfront Discount on Sales $"))
			+
			CALCULATE([Forecast],filter('Forecast (Channel)','Forecast (Channel)'[Measure]="Gross Return (RTV) $"))
			-
			CALCULATE([Forecast],FILTER('Forecast (Channel)','Forecast (Channel)'[Measure]="Dilutions $"),filter('Forecast (Channel)','Forecast (Channel)'[Order Type]="RTV DISCOUNT OFFSET"))
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: 98bd9d70-c2df-42cc-9529-944f85822925

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure Budget =
			VAR NoConversionMeasures={"Transactions","Units","Traffic"}
			RETURN
			CALCULATE(
			if(
			    or(SELECTEDVALUE('Currency Selector'[Currency Selection])="Local",SELECTEDVALUE('Budget (Channel)'[Measure]) in NoConversionMeasures),
			    SUM('Budget (Channel)'[Budget Value]),
			    VAR AggregatedInCurrency=
			    ADDCOLUMNS(
			        SUMMARIZE(
			            'Budget (Channel)',
			            'Budget (Channel)'[Currency Key]
			        ),
			        "@NetPrice",calculate( sum('Budget (Channel)'[Budget Value])),
			        "@Rate",LOOKUPVALUE('Currency'[Conversion Value],'Currency'[Currency Key],'Budget (Channel)'[Currency Key],'Currency'[Conversion Type],selectedvalue('Currency'[Conversion Type])),
			        "@DefaultRate",LOOKUPVALUE('Currency'[Conversion Value],'Currency'[Currency Key],'Budget (Channel)'[Currency Key],'Currency'[Conversion Type],"BUDGET_TO_USD")
			    )  //Creates a table summing dollars by date with the currently selected and default conversion rate for that date
			    VAR Result=
			    IF (
			        HASONEVALUE ( 'Currency Selector'[Currency Selection] ),
			        SUMX (
			            AggregatedInCurrency,
			            [@NetPrice]*[@Rate]
			            ),
			            SUMX (
			            AggregatedInCurrency,
			            [@NetPrice]*[@DefaultRate]
			            )
			        )
			    RETURN
			Result
			),
			TREATAS(VALUES('Channel (DTC Original)'[Original Finance Channel]),'Budget (Channel)'[Channel]),
			TREATAS(VALUES('Channel (DTC Allocated)'[Allocated Finance Channel]),'Budget (Channel)'[Channel]),
			TREATAS(VALUES('Channel'[Finance Channel]),'Budget (Channel)'[Channel]),
			TREATAS(VALUES(Store[Store Finance Channel]),'Budget (Channel)'[Channel]),
			TREATAS(VALUES('Store (DTC Original)'[Original Finance Channel]),'Budget (Channel)'[Channel]),
			TREATAS(VALUES('Store (DTC Allocated)'[Allocated Finance Channel]),'Budget (Channel)'[Channel])
			)
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: 2ff0dc31-d6ea-4e9d-a379-0a0c38ced885

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Store Budget' =
			VAR NoConversionMeasures={"Transactions","Units","Traffic"}
			RETURN
			if(
			    or(SELECTEDVALUE('Currency Selector'[Currency Selection])="Local",SELECTEDVALUE('Budget (DTC Store)'[Measure]) in NoConversionMeasures),
			    SUM('Budget (DTC Store)'[Budget Store Value]),
			    VAR AggregatedInCurrency=
			    ADDCOLUMNS(
			        SUMMARIZE(
			            'Budget (DTC Store)',
			            'Budget (DTC Store)'[Currency Code],
			            'Budget (DTC Store)'[Date Key]
			        ),
			        "@NetPrice",calculate( sum('Budget (DTC Store)'[Budget Store Value])),
			        "@Rate",LOOKUPVALUE('Currency'[Conversion Value],'Currency'[Currency Date Key],'Budget (DTC Store)'[Date Key], 'Currency'[Currency],'Budget (DTC Store)'[Currency Code],'Currency'[Conversion Type],selectedvalue('Currency'[Conversion Type])),
			        "@DefaultRate",LOOKUPVALUE('Currency'[Conversion Value],'Currency'[Currency Date Key],'Budget (DTC Store)'[Date Key], 'Currency'[Currency],'Budget (DTC Store)'[Currency Code],'Currency'[Conversion Type],"BUDGET_TO_USD")
			    )  //Creates a table summing dollars by date with the currently selected and default conversion rate for that date
			    VAR Result=
			    IF (
			        HASONEVALUE ( 'Currency Selector'[Currency Selection] ),
			        SUMX (
			            AggregatedInCurrency,
			            [@NetPrice]*[@Rate]
			            ),
			            SUMX (
			            AggregatedInCurrency,
			            [@NetPrice]*[@DefaultRate]
			            )
			        )
			    RETURN
			Result
			)
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: 9603a405-fbde-47af-ac5c-426012a0fbf5

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

