	measure Plan =
			if(
			    SELECTEDVALUE('Currency Selector'[Currency Selection])="Local",
			    SUM('Plan (Wholesale Retail)'[Plan Value]),
			    IF (
			        HASONEVALUE ( 'Currency Selector'[Currency Selection] ),
			            SUMX (
			                'Plan (Wholesale Retail)',
			                'Plan (Wholesale Retail)'[Plan Value]*LOOKUPVALUE('Currency'[Conversion Value],'Currency'[Currency Key],'Plan (Wholesale Retail)'[Currency Key],'Currency'[Conversion Type],selectedvalue('Currency'[Conversion Type]))
			                )
			    )
