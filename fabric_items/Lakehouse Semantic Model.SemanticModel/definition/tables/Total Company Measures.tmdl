table 'Total Company Measures'
	lineageTag: 91e2d494-2318-4dee-8eb8-07b9b740753c
	sourceLineageTag: [dbo].[Total Company Measures]

	measure 'External Retail Sales Units' =
			
			SUM(
			    'Transactions (External POS)'[Sales Units]
			)
		formatString: #,0
		lineageTag: 497863b5-7360-4cf1-878e-5a36bfd661bf

		changedProperty = FormatString

		changedProperty = IsHidden

	measure 'External Sell Through %' =
			DIVIDE(
			    [External Retail Sales Units],
			    [External Retail Sales Units]+[External Quantity On Hand]
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 59e1a258-d902-444c-b338-362be2b153e5

		changedProperty = FormatString

		changedProperty = IsHidden

	measure 'Overall External Full Price %' =
			DIVIDE(
			    CALCULATE([External Retail Sales $],
			    'Transactions (External POS)'[Mark Type]="FP"
			    ),
			    [External Retail Sales $]
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: b5c8ca54-9aea-4695-abc0-66e821d3704e

		changedProperty = FormatString

		changedProperty = IsHidden

	measure 'Units (Sum)' =
			
			sum(
			    'Transactions (Financial)'[Quantity]
			)
		formatString: #,0
		lineageTag: fd0ae322-fc1a-45ab-970e-ff427e08e62b

		changedProperty = FormatString

		changedProperty = IsHidden

	measure 'External Cost $' =
			if(
			    SELECTEDVALUE('Currency Selector'[Currency Selection])="Local",
			    SUM('Transactions (External POS)'[On Hand Cost]),
			    VAR AggregatedInCurrency=
			    ADDCOLUMNS(
			        SUMMARIZE(
			            'Transactions (External POS)',
			            'Transactions (External POS)'[Currency Key]
			        ),
			        "@NetPrice",calculate( sum('Transactions (External POS)'[On Hand Cost])),
			        "@Rate",LOOKUPVALUE('Currency'[Conversion Value],'Currency'[Currency Key],'Transactions (External POS)'[Currency Key],'Currency Selector'[Currency Selection],SELECTEDVALUE('Currency Selector'[Currency Selection])),
			        "@DefaultRate",LOOKUPVALUE('Currency'[Conversion Value],'Currency'[Currency Key],'Transactions (External POS)'[Currency Key],'Currency'[Conversion Type],"BUDGET_TO_USD")
			    )  //Creates a table summing dollars by date with the currently selected and default conversion rate for that date
			    VAR Result=
			    IF (
			        HASONEVALUE ( 'Currency Selector'[Currency Selection] ),
			        SUMX (
			            AggregatedInCurrency,
			            [@NetPrice]*[@Rate]
			            ),
			            SUMX (
			            AggregatedInCurrency,
			            [@NetPrice]*[@DefaultRate]
			            )
			    )
			    RETURN
			    Result
			)
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: c88dcb23-2bfe-4ecd-9377-9087ef68dde9

		changedProperty = FormatString

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

