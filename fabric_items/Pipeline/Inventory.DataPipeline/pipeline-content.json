        "typeProperties": {
          "source": {
            "type": "SnowflakeSource",
            "query": "SELECT \n    T.UNITS_ON_HAND AS \"Units On Hand\",\n    T.LOCATION AS \"Location\",\n    T.STORE_KEY AS \"Store Key\",\n    T.WAREHOUSE_KEY AS \"Warehouse Key\",\n    T.CHANNEL_KEY AS \"Channel Key\",\n    T.PRODUCT_KEY AS \"Product Key\",\n    T.DELIVERY_KEY AS \"Delivery Key\",\n    T.PRICE_CATEGORIZATION_KEY AS \"Price Categorization Key\",\n    PC.MARK_TYPE AS \"Mark Type\",\n    T.UNITS_ON_HAND * P.STANDARD_COST AS \"Cost On Hand\",\n    T.UNITS_ON_HAND * P.RETAIL_PRICE AS \"Retail On Hand\",\n    CAST(T.EFFECTIVE_START_DATE AS DATE) AS \"Start Date\",\n    CAST(T.EFFECTIVE_END_DATE AS DATE) AS \"End Date\",\n    CASE WHEN P.DEPARTMENT_CODE_MI9 > 89 THEN 1 END AS \"Dtc Misc Flag\"\nFROM EDW_V.F_INVENTORY_ON_HAND T\nLEFT OUTER JOIN EDW_V.D_PRODUCT P ON T.PRODUCT_KEY = P.PRODUCT_KEY\nLEFT OUTER JOIN EDW_T.D_PRICE_CATEGORIZATION PC ON T.PRICE_CATEGORIZATION_KEY = PC.PRICE_CATEGORIZATION_KEY",
