{
  "properties": {
    "activities": [
      {
        "type": "Copy",
        "typeProperties": {
          "source": {
            "type": "SnowflakeSource",
            "query": " SELECT \n    T.TRANSACTION_ID  as        \"Transaction Id\",\n\tT.TRANSACTION_LINE_ID  as\t\t\"Transaction Line Id\",\n\tT.TRANSACTION_NO  as\t\t\"Transaction No\",\n\tT.TRANSACTION_LINE_NO  as\t\t\"Transaction Line No\",\n\tT.TRANSACTION_DATE  as\t\t\"Transaction Date\",\n\tCAST(T.TRANSACTION_DATE_KEY AS INT) as\t\t\"Transaction Date Key\",\n\tT.TRANSACTION_TYPE  as\t\t\"Transaction Type\",\n\tT.ORDER_TYPE as\t\t\"Order Type\",\n\tT.STORE_ID  as\t\t\"Store Id\",\n\tT.STORE_KEY  as\t\t\"Store Key\",\n\tT.CHANNEL_NAME  as\t\t\"Channel Name\",\n\tT.CHANNEL_KEY  as\t\t\"Channel Key\",\n\tT.REGISTER_NUM  as\t\t\"Register Num\",\n\tT.EMPLOYEE_KEY  as\t\t\"Employee Key\",\n\tT.CUSTOMER_NUMBER  as\t\t\"Customer Number\",\n\tT.CUSTOMER_KEY  as\t\t\"Customer Key\",\n\tT.PRODUCT_KEY  as\t\t\"Product Key\",\n\tT.DELIVERY_KEY  as\t\t\"Delivery Key\",\n\tT.E_SELL_ORDER_NUM  as\t\t\"E Sell Order Num\",\n\tT.QUANTITY   as\t\t\"Quantity\",\n\tT.PRICE_CATEGORIZATION_KEY  as\t\t\"Price Categorization Key\",\n\tT.ORDER_CATEGORIZATION_KEY  as\t\t\"Order Categorization Key\",\n\tT.CURRENCY_KEY  as\t\t\"Currency Key\",\n\tT.UNIT_RETAIL_PRICE  as\t\t\"Unit Retail Price\",\n\tT.TOTAL_PRICE  as\t\t\"Total Price\",\n\tT.NET_PRICE  as\t\t\"Net Price\",\n\tT.TAX_AMOUNT  as\t\t\"Tax Amount\",\n\tT.DISCOUNT_AMOUNT  as\t\t\"Discount Amount\",\n\tT.CALC_RETURNED_AMT  as\t\t\"Calc Returned Amt\",\n\tT.GIFT_FLAG  as\t\t\"Gift Flag\",\n\tT.RETURNED_FLAG  as\t\t\"Returned Flag\",\n\tT.RETURN_REASON_CODE  as\t\t\"Return Reason Code\",\n\tT.RETURN_REASON_DESC  as\t\t\"Return Reason Desc\",\n\tT.CANCEL_FLAG  as\t\t\"Cancel Flag\",\n\tT.CANCEL_REASON_CODE  as\t\t\"Cancel Reason Code\",\n\tT.ALLOCATED_STORE_KEY  as\t\t\"Allocated Store Key\",\n\tT.ETL_SOURCE_SYSTEM_CD  as\t\t\"Etl Source System Cd\",\n    COALESCE(T.ORIGINAL_STORE_KEY, T.STORE_KEY) AS \"Original Store Key\", \n    S.CHANNEL_KEY AS \"Original Channel Key\",\n    CASE \n        WHEN T.ORDER_TYPE = 'LIQ' THEN '3RD PARTY'\n        WHEN T.ORDER_TYPE = 'DRS' THEN 'DROP SHIP'\n        WHEN T.ORDER_TYPE = 'REO' AND LEFT(P.FES_CODE, 1) = 'F' THEN 'FASHION REORDER'\n        WHEN T.ORDER_TYPE NOT IN ('DRS', 'LIQ') AND LEFT(P.FES_CODE, 1) = 'E' THEN 'QR'\n        ELSE 'FASHION INITIALS'\n    END AS \"Dashboard Order Type\",\n    PC.MARK_TYPE as \"Mark Type\",\n    PC.POS_PRESENT as \"Pos Present\", \n    PC.SELLING_PRICE as \"Selling Price\",\n    C.CURRENCY as \"Currency\",\n    CASE WHEN P.DEPARTMENT_CODE_MI9 > 89 THEN 1 END AS \"Dtc Misc Flag\",\n    COALESCE(\n        CASE\n            WHEN C.CURRENCY = 'CAD' THEN P.CAN_STANDARD_COST\n            WHEN C.CURRENCY = 'GBP' THEN P.GBP_STANDARD_COST\n            ELSE P.STANDARD_COST\n        END,\n        CASE\n            WHEN S.DIVSION_DESCRIPTION = 'Company Stores' THEN P.COST_AVERAGE_WEIGHTED_COMPANY \n            WHEN S.REGION_DESCRIPTION = 'Northwest Canada Stores' THEN P.COST_AVERAGE_WEIGHTED_CANADA\n            ELSE P.COST_AVERAGE_WEIGHTED_US\n        END\n    ) AS \"Currency Based Cost\",\n    (\"Currency Based Cost\" * T.QUANTITY) AS \"Total Cost\"\nFROM EDW_PROD.EDW_V.F_TRANSACTION T\nLEFT OUTER JOIN EDW_PROD.EDW_V.D_PRODUCT_CURRENT_NEW P ON T.PRODUCT_KEY = P.PRODUCT_KEY\nLEFT OUTER JOIN EDW_PROD.EDW_T.D_PRICE_CATEGORIZATION PC ON T.PRICE_CATEGORIZATION_KEY = PC.PRICE_CATEGORIZATION_KEY\nLEFT OUTER JOIN EDW_PROD.EDW_T.D_CURRENCY C ON T.CURRENCY_KEY = C.CURRENCY_KEY \nLEFT OUTER JOIN EDW_PROD.EDW_V.D_STORE S ON COALESCE(T.ORIGINAL_STORE_KEY, T.STORE_KEY) = S.STORE_KEY\n--WHERE T.TRANSACTION_DATE >= DATEADD(day, -180, CURRENT_DATE())\n\n",
            "exportSettings": {
              "type": "SnowflakeExportCopyCommand"
            },
