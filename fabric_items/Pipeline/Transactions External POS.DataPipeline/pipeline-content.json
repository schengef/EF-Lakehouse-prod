        "typeProperties": {
          "source": {
            "type": "SnowflakeSource",
            "query": "select \nCAST(T.WEEK_ENDING_DATE_KEY AS INT) AS \"Week Ending Date Key\", \nCAST(T.STORE_KEY AS INT) AS \"Store Key\", \nCAST(T.PRODUCT_KEY AS INT) AS \"Product Key\", \nT.SALES_UNITS AS \"Sales Units\", \nT.SALES_DOLLARS AS \"Sales Dollars\", \nT.OH_UNITS AS \"Oh Units\", \nCAST(T.CURRENCY_KEY AS INT) AS \"Currency Key\", \nCAST(T.PRICE_CATEGORIZATION_KEY AS INT) AS \"Price Categorization Key\", \nCAST(T.DELIVERY_KEY AS INT) AS \"Delivery Key\", \nCAST(T.CHANNEL_KEY AS INT) AS \"Channel Key\", \nPC.MARK_TYPE AS \"Mark Type\",\nCASE WHEN C.CURRENCY='CAD' then P.CAN_STANDARD_COST else P.STANDARD_COST end  as \"Currency Based Unit Cost\"\n,(\"Currency Based Unit Cost\"*T.OH_UNITS) as \"On Hand Cost\"\n,(\"Currency Based Unit Cost\"*T.SALES_UNITS) as \"Sales Cost\"\n,P.RETAIL_PRICE*T.OH_UNITS as \"On Hand Retail\"\n, S.WHOLESALE_ACCOUNT_KEY AS \"Wholesale Account Key\"\nfrom EDW_V.V_EXTERNAL_TRANSACTIONS_POS T\nLEFT OUTER JOIN EDW_T.D_PRICE_CATEGORIZATION PC ON T.PRICE_CATEGORIZATION_KEY = PC.PRICE_CATEGORIZATION_KEY\nLEFT OUTER JOIN EDW_V.D_PRODUCT P ON T.PRODUCT_KEY = P.PRODUCT_KEY\nLEFT OUTER JOIN EDW_T.D_CURRENCY C ON T.CURRENCY_KEY = C.CURRENCY_KEY \nLEFT OUTER JOIN EDW_T.D_STORE S ON T.STORE_KEY = S.STORE_KEY ",
