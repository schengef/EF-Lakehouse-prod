	measure 'Executive Summary Invoiced Sales Budget Month' = ```
			VAR LastDateAvailable=min(LASTDATE('Date'[Date]),LASTDATE('Date EOY'[Date]))
			VAR LastDayAvailable =  LOOKUPVALUE('Date EOY'[MonthIndex],'Date EOY'[date],LastDateAvailable,'Date EOY'[Select a Calendar],SELECTEDVALUE('Date EOY'[Select a Calendar]))
			VAR LastFiscalYearMonthAvailable = LOOKUPVALUE('Date EOY'[Monthnum],'Date EOY'[date],LastDateAvailable,'Date EOY'[Select a Calendar],SELECTEDVALUE('Date EOY'[Select a Calendar]))
			VAR LastFiscalYear = LOOKUPVALUE('Date EOY'[Year],'Date EOY'[date],LastDateAvailable,'Date EOY'[Select a Calendar],SELECTEDVALUE('Date EOY'[Select a Calendar]))   
			Return
			
			    CALCULATE (
			        [Budget Net Invoiced Sales $],
			 ALLEXCEPT('Date EOY', 'Date EOY'[Select a Calendar],'Date EOY'[MonthNum]),
			    'Date EOY'[MonthIndex]  <= LastDayAvailable &&
			     'Date EOY'[MonthNum]= LastFiscalYearMonthAvailable &&
			    'Date EOY'[Year] = LastFiscalYear       
			)
			```
		formatString: 0
		displayFolder: Executive Dashboard\Sales\Wholesale
		lineageTag: e243b41e-1a82-44b2-82f1-2923630d031a

	measure 'Executive Summary Invoiced Sales Budget Week' = ```
			VAR LastDateAvailable=min(LASTDATE('Date'[Date]),LASTDATE('Date EOY'[Date]))
			VAR LastFiscalYearWeekAvailable = LOOKUPVALUE('Date EOY'[Week End Date],'Date EOY'[date],LastDateAvailable,'Date EOY'[Select a Calendar],SELECTEDVALUE('Date EOY'[Select a Calendar]))
			VAR LastFiscalYear = LOOKUPVALUE('Date EOY'[Year],'Date EOY'[date],LastDateAvailable,'Date EOY'[Select a Calendar],SELECTEDVALUE('Date EOY'[Select a Calendar]))   
			Return 
			CALCULATE (
			    [Budget Net Invoiced Sales $],
			    ALLEXCEPT('Date EOY', 'Date EOY'[Select a Calendar],'Date EOY'[Week End Date]),
			    'Date EOY'[Week End Date]  = LastFiscalYearWeekAvailable &&
			    'Date EOY'[Year] = LastFiscalYear        
			)
			```
		formatString: 0
		displayFolder: Executive Dashboard\Sales\Wholesale
		lineageTag: bb454c2f-7f83-4d96-9c5f-8bf47a04f5af

	measure 'Executive Summary Invoiced Sales Budget Year' = ```
			VAR DayTY=CALCULATE(min('Date EOY'[Date]),'Date EOY'[Date]=TODAY())  //4/16/2026
			VAR YearTY=CALCULATE(max('Date EOY'[Year]),'Date EOY'[Date]=DayTY)    //2025
			Return 
			    CALCULATE (
			        [Budget Net Invoiced Sales $],
			  ALLEXCEPT('Date EOY', 'Date EOY'[Select a Calendar]),
			    'Date EOY'[Date]<=DayTY,
			     'Date EOY'[Year] = YearTY
			)
			
			```
		formatString: $#,###;($#,###)
		displayFolder: Executive Dashboard\Sales\Wholesale
		lineageTag: c6f6062e-4df6-4215-8a79-bd4f7c9f783e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Executive Summary Invoiced Sales LY MTD' = ```
			VAR LastDayAvailable = max('Date'[Date])+ if(max('Date'[Date])>=today(),WEEKDAY(today(), 1)-8,0)
			VAR LastDayLY=LOOKUPVALUE('Date EOY'[Date LY],'Date EOY'[Date],LastDayAvailable)
			VAR LY=CALCULATETABLE(SUMMARIZECOLUMNS('Date EOY'[Date LY], FILTER('Date EOY','Date EOY'[Year]=max('Date EOY'[Year]))),ALLEXCEPT('Date EOY','Date EOY'[Select a Calendar]))
			VAR LastMonth=LOOKUPVALUE('Date EOY'[Monthnum],'Date EOY'[Date],LastDayAvailable,'Date EOY'[Select a Calendar],SELECTEDVALUE('Date EOY'[Select a Calendar]))
			VAR LM=CALCULATETABLE(SUMMARIZECOLUMNS('Date EOY'[Date LY], FILTER('Date EOY','Date EOY'[Monthnum]=LastMonth)),ALLEXCEPT('Date EOY','Date EOY'[Select a Calendar]))
			Return
			CALCULATE (
			    [Net Invoiced Sales $],
			    ALLEXCEPT('Date EOY', 'Date EOY'[Select a Calendar]),
			    'Date EOY'[Date] in LM &&
			    'Date EOY'[Date] in LY &&
			    'Date EOY'[Date]<=LastDayLY       
			)
			```
		formatString: $#,###;($#,###)
		displayFolder: Executive Dashboard\Sales\Wholesale
		lineageTag: 74587c65-8d05-4e59-abd0-4292bac1601c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Executive Summary Invoiced Sales LY WTD' = ```
			VAR LastDayAvailable = max('Date'[Date])+ if(max('Date'[Date])>=today(),WEEKDAY(today(), 1)-8,0)
			VAR LastDayLY=LOOKUPVALUE('Date EOY'[Date LY],'Date EOY'[Date],LastDayAvailable)
			VAR LW=SUMMARIZECOLUMNS('Date EOY'[Date LY], FILTER('Date EOY','Date EOY'[Week End Date]=max('Date EOY'[Week End Date])))
			Return
			CALCULATE (
			    [Net Invoiced Sales $],
			    ALLEXCEPT('Date EOY', 'Date EOY'[Select a Calendar]),
			    'Date EOY'[Date] in LW &&
			    'Date EOY'[Date]<=LastDayLY   
			)
			```
