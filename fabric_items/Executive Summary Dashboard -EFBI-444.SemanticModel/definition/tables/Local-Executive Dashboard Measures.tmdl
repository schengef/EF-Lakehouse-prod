		displayFolder: Weekly DTC (Detail)\Cost On Hand
		lineageTag: 4a27dec4-1d65-4524-a276-9e51e4d75190

	measure 'Cost On Hand $ LY' =
			
			VAR LastDayAvailable = if(SELECTEDVALUE('Date'[Week End Date])>TODAY(),SELECTEDVALUE('Date'[Week End Date]),max('Date'[Date])+ if(max('Date'[Date])>=today(),WEEKDAY(today(), 1)-8,0))
			VAR LastDayLY=LOOKUPVALUE('Date EOY'[Date LY],'Date EOY'[Date],LastDayAvailable)
			RETURN
			CALCULATE (
			    [EOP Cost $ On Hand],
			    ALLEXCEPT('Date EOY', 'Date EOY'[Select a Calendar]),
			    'Date EOY'[Date] =LastDayLY
			)
		formatString: $#,###;($#,###)
		displayFolder: Weekly DTC (Detail)\Cost On Hand
		lineageTag: 2aa3f6e9-70cf-47a4-b49a-ef1709841adf

		annotation PBI_FormatHint = {"isCustom":true}

