			        KEEPFILTERS('Accounts'[Country]="US")
			        ),[Retail YTD PL]),"0.0%;(0.0%)"),
			    "% DOMESTIC WEB",format(
			        divide(CALCULATE(
			        [Retail YTD PL],
			        KEEPFILTERS('Plan (Wholesale Retail)'[Type]="WEB"),
			        KEEPFILTERS('Accounts'[Country]="US")
			        ),[Retail YTD PL]),"0.0%;(0.0%)")
			    )
		formatString: $#,###;($#,###)
		displayFolder: Wholesale Retail\Summary\YTD
		lineageTag: 77bf61c1-34b8-42e9-a5b6-0d3b5ad1271d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Retail Summary YTD TY' = ```
			
			VAR StoreType={"DPT","DNM"}
			VAR WebType={"MOW","MNM"}
			RETURN
			SWITCH(
			    SELECTEDVALUE('Headers - Wholesale Retail'[Summary Rows]),
			    "DOMESTIC STORELINE", format(CALCULATE(
			        [Retail YTD TY],
			        KEEPFILTERS('Store'[Store Type] in StoreType)
			        ),"$#,###;($#,###)"),
			    "DOMESTIC WEB",format(CALCULATE(
			        [Retail YTD TY],
			        KEEPFILTERS('Store'[Store Type] in WebType)
			        ),"$#,###;($#,###)"),
			    "TOTAL",format(
			        [Retail YTD TY],"$#,###;($#,###)"),
			    "% DOMESTIC STORELINE",format(
			        divide(CALCULATE(
			        [Retail YTD TY],
			        KEEPFILTERS('Store'[Store Type] in StoreType),
			        KEEPFILTERS('Accounts'[Country]="US")
			        ),[Retail YTD TY]),"0.0%;(0.0%)"),
			    "% DOMESTIC WEB",format(
			        divide(CALCULATE(
			        [Retail YTD TY], 
			        KEEPFILTERS('Store'[Store Type] in WebType),
			        KEEPFILTERS('Accounts'[Country]="US")
			        ),[Retail YTD TY]),"0.0%;(0.0%)")
			    )
			```
		formatString: $#,###;($#,###)
		displayFolder: Wholesale Retail\Summary\YTD
		lineageTag: 9f55bf9d-92ce-49b8-b0f4-171d2992b392

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Retail TY' = ```
			
			SWITCH( 
			    SELECTEDVALUE('Headers - Wholesale Retail'[Wholesale Retail Period]),
			    "WTD",[Retail WTD TY],
			    "MTD",[Retail MTD TY],
			    "STD",[Retail STD TY],
			    "YTD",[Retail YTD TY]
			)
			```
		formatString: $#,###;($#,###)
		displayFolder: Wholesale Retail\Display
		lineageTag: 4a3b0351-4fb7-4d51-96a4-48812b1b568e

	measure 'Retail WTD LY' =
			VAR LastDayAvailable = max('Date'[Date])+ if(max('Date'[Date])>=today(),WEEKDAY(today(), 1)-8,0)
			VAR LastDayLY=LOOKUPVALUE('Date'[Date LY],'Date'[Date],LastDayAvailable)
			VAR LW=SUMMARIZECOLUMNS('Date'[Date LY], FILTER('Date','Date'[Week End Date]=max('Date'[Week End Date])))
			Return
			    CALCULATE (
			        [Net External Retail Sales $ MIX],
			        ALLEXCEPT('Date', 'Date'[Select a Calendar]),
			        'Date'[Date] in LW &&
			        'Date'[Date]<=LastDayLY
			    )
		formatString: $#,###;($#,###)
		displayFolder: Wholesale Retail\WTD
		lineageTag: 2500ebd6-bf3a-402d-9112-2896d0c7824e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Retail WTD PL' =
			
			VAR LastDayAvailable =  max('Date'[DayOfWeek])
			    VAR LastFiscalYearWeekAvailable = MAX ( 'Date'[Week End Date] )
			    VAR LastFiscalYear = MAX ( 'Date'[Year] )
			    Return
			        CALCULATE (
			            [Plan],
			           ALLEXCEPT('Date', 'Date'[Select a Calendar],'Date'[Week End Date]),
			            'Date'[DayOfWeek]  <= LastDayAvailable &&
			            'Date'[Week End Date] = LastFiscalYearWeekAvailable &&
			            'Date'[Year] = LastFiscalYear
			        )
		formatString: $#,###;($#,###)
		displayFolder: Wholesale Retail\WTD
		lineageTag: 683f9825-dfdd-45d9-b0ee-28aa2d1fa9b8

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Retail WTD TY' = ```
			
			VAR LastDayAvailable =  max('Date'[DayOfWeek])
			    VAR LastFiscalYearWeekAvailable = MAX ( 'Date'[Week End Date] )
			    VAR LastFiscalYear = MAX ( 'Date'[Year] )
			    Return 
			        CALCULATE (
			            [Net External Retail Sales $ MIX],
			         ALLEXCEPT('Date', 'Date'[Select a Calendar],'Date'[Week End Date]),
			            'Date'[DayOfWeek]  <= LastDayAvailable &&
			            'Date'[Week End Date] = LastFiscalYearWeekAvailable &&
			            'Date'[Year] = LastFiscalYear
			        )
			```
		displayFolder: Wholesale Retail\WTD
		lineageTag: 36b2e3de-b0c4-42d2-9aed-7ecee14538cd

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Retail YTD LY' = ```
			
			VAR LastDayAvailable = max('Date'[Date])+ if(max('Date'[Date])>=today(),WEEKDAY(today(), 1)-8,0)
			VAR LastDayLY=LOOKUPVALUE('Date'[Date LY],'Date'[Date],LastDayAvailable)
			VAR LY=CALCULATETABLE(SUMMARIZECOLUMNS('Date'[Date LY], FILTER('Date','Date'[Year]=max('Date'[Year]))),ALLEXCEPT('Date','Date'[Select a Calendar])) 
			Return    
			CALCULATE (
			    [Net External Retail Sales $ MIX],
			    ALLEXCEPT('Date', 'Date'[Select a Calendar]),
			    'Date'[Date] in LY &&
			    'Date'[Date]<=LastDayLY 
			)
			```
		formatString: $#,###;($#,###)
		displayFolder: Wholesale Retail\YTD
		lineageTag: 407b597f-922a-4992-b828-f6d9385b5b5f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Retail YTD PL' = ```
			
			VAR LastDayAvailable = LOOKUPVALUE('Date'[DayOfYear],'Date'[Date],LASTDATE('Date'[Date]),'Date'[Select a Calendar],SELECTEDVALUE('Date'[Select a Calendar] ))
			VAR LastFiscalYearMonthAvailable = MAX('Date'[MonthNum])
			VAR LastFiscalYear = MAX ( 'Date'[Year] )
			Return    
			CALCULATE (
			    [Plan],
			   ALLEXCEPT('Date', 'Date'[Select a Calendar],'Date'[MonthNum]),
			    'Date'[DayOfYear] <= LastDayAvailable &&  
			    'Date'[MonthNum]<= LastFiscalYearMonthAvailable &&
			    'Date'[Year] = LastFiscalYear
			)
			```
		formatString: $#,###;($#,###)
		displayFolder: Wholesale Retail\YTD
		lineageTag: a2f9d8a2-c30e-4211-acee-96ae94d24f0f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Retail YTD TY' = ```
			
			VAR DayTY=CALCULATE(min('Date EOY'[Date]),'Date EOY'[Date]=TODAY())  //4/16/2026
			VAR YearTY=CALCULATE(max('Date EOY'[Year]),'Date EOY'[Date]=DayTY)    //2025
			Return 
			
			CALCULATE (
			    [Net External Retail Sales $ MIX],
			  ALLEXCEPT('Date EOY', 'Date EOY'[Select a Calendar]),
			    'Date EOY'[Date]<=DayTY,
			     'Date EOY'[Year] = YearTY
			)
			
			```
