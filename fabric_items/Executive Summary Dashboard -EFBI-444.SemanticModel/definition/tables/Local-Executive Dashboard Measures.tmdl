		lineageTag: 46cc40cc-4cdd-4a7c-8abb-f4d22c4631d9

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Executive Summary Stock AUR DTC MTD' = ```
			
			VAR LastDayAvailable = max('Date'[Date])+ if(max('Date'[Date])>=today(),WEEKDAY(today(), 1)-8,0)
			VAR LastDayLY=LOOKUPVALUE('Date EOY'[Date],'Date EOY'[Date],LastDayAvailable)
			VAR TY=CALCULATETABLE(SUMMARIZECOLUMNS('Date EOY'[Date], FILTER('Date EOY','Date EOY'[Year]=max('Date EOY'[Year]))),ALLEXCEPT('Date EOY','Date EOY'[Select a Calendar]))
			VAR LastMonth=LOOKUPVALUE('Date EOY'[Monthnum],'Date EOY'[Date],LastDayAvailable,'Date EOY'[Select a Calendar],SELECTEDVALUE('Date EOY'[Select a Calendar]))
			VAR TM=CALCULATETABLE(SUMMARIZECOLUMNS('Date EOY'[Date], FILTER('Date EOY','Date EOY'[Monthnum]=LastMonth)),ALLEXCEPT('Date EOY','Date EOY'[Select a Calendar]))  
			VAR DTCChannels={"Digital","Full Price US Stores","Company Stores","Canada","Renew Stores"}
			Return
			CALCULATE (
			    [DTC AUR Average],
			    ALLEXCEPT('Date EOY', 'Date EOY'[Select a Calendar]),
			    'Date EOY'[Date] in TM &&
			    'Date EOY'[Date] in TY &&
			    'Date EOY'[Date]<=LastDayLY,
			    'Store'[Store Finance Channel] in DTCChannels
			)
			```
		formatString: $#,###;($#,###)
		displayFolder: Executive Dashboard\Stock AUR\DTC
		lineageTag: 814af41c-ae35-406f-a3bd-0723d43ac580

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Executive Summary Stock AUR DTC WTD' = ```
			
			VAR LastDayAvailable = max('Date'[Date])+ if(max('Date'[Date])>=today(),WEEKDAY(today(), 1)-8,0)
			VAR LastDay=LOOKUPVALUE('Date EOY'[Date],'Date EOY'[Date],LastDayAvailable)
			VAR LW=SUMMARIZECOLUMNS('Date EOY'[Date], FILTER('Date EOY','Date EOY'[Week End Date]=max('Date EOY'[Week End Date])))   
			VAR DTCChannels={"Digital","Full Price US Stores","Company Stores","Canada","Renew Stores"}
			RETURN
			CALCULATE (
			    [DTC AUR Average],
			    ALLEXCEPT('Date EOY', 'Date EOY'[Select a Calendar]),
			    'Date EOY'[Date] in LW &&
			    'Date EOY'[Date]<=LastDay,
			    'Store'[Store Finance Channel] in DTCChannels
			)
			```
		formatString: $#,###;($#,###)
		displayFolder: Executive Dashboard\Stock AUR\DTC
		lineageTag: 0bca376e-8df4-440b-92bd-72a64109d1e8

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Executive Summary Stock AUR DTC YTD' = ```
			VAR DayTY=CALCULATE(min('Date EOY'[Date]),'Date EOY'[Date]=TODAY())  //4/16/2026
			VAR YearTY=CALCULATE(max('Date EOY'[Year]),'Date EOY'[Date]=DayTY)    //2025
			Return 
			
			CALCULATE (
			    [DTC AUR Average],
			 ALLEXCEPT('Date EOY', 'Date EOY'[Select a Calendar]),
			    'Date EOY'[Date]<=DayTY,
			     'Date EOY'[Year] = YearTY
			)
			
			```
		formatString: $#,###;($#,###)
		displayFolder: Executive Dashboard\Stock AUR\DTC
		lineageTag: d465c60c-b1ec-4199-a6ba-f3374072e718

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Executive Summary Stock AUR Total MTD' = ```
			
			VAR LastDayAvailable = max('Date'[Date])+ if(max('Date'[Date])>=today(),WEEKDAY(today(), 1)-8,0)
			VAR LastDayLY=LOOKUPVALUE('Date EOY'[Date],'Date EOY'[Date],LastDayAvailable)
			VAR TY=CALCULATETABLE(SUMMARIZECOLUMNS('Date EOY'[Date], FILTER('Date EOY','Date EOY'[Year]=max('Date EOY'[Year]))),ALLEXCEPT('Date EOY','Date EOY'[Select a Calendar]))
			VAR LastMonth=LOOKUPVALUE('Date EOY'[Monthnum],'Date EOY'[Date],LastDayAvailable,'Date EOY'[Select a Calendar],SELECTEDVALUE('Date EOY'[Select a Calendar]))
			VAR TM=CALCULATETABLE(SUMMARIZECOLUMNS('Date EOY'[Date], FILTER('Date EOY','Date EOY'[Monthnum]=LastMonth)),ALLEXCEPT('Date EOY','Date EOY'[Select a Calendar]))  
			VAR DTCChannels={"Digital","Full Price US Stores","Company Stores","Canada","Renew Stores"}
			Return
			CALCULATE (
			    DIVIDE(
			        [EOP External $ On Hand POS]+CALCULATE([EOP Retail $ On Hand], Channel[Finance Channel] in DTCChannels),
			        [EOP External Units On Hand POS]+CALCULATE([EOP Quantity On Hand], Channel[Finance Channel] in DTCChannels)
			    ),
			    ALLEXCEPT('Date EOY', 'Date EOY'[Select a Calendar],'Date EOY'[MonthNum]),
			    'Date EOY'[Date] in TM &&
			    'Date EOY'[Date] in TY &&
			    'Date EOY'[Date]<=LastDayLY,
			    OR(ISNUMBER(Inventory[Location]),Inventory[Location] in {"EFW","EFRDR"})
			)
			```
		formatString: $#,###;($#,###)
		displayFolder: Executive Dashboard\Stock AUR\Total Company
		lineageTag: 391b9460-7d57-483a-b526-9fb834751400

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Executive Summary Stock AUR Total WTD' = ```
			
			VAR LastDateAvailable=min(LASTDATE('Date'[Date]),LASTDATE('Date EOY'[Date]))
			VAR LastFiscalYearWeekAvailable = LOOKUPVALUE('Date EOY'[Week End Date],'Date EOY'[date],LastDateAvailable,'Date EOY'[Select a Calendar],SELECTEDVALUE('Date EOY'[Select a Calendar]))
			VAR LastFiscalYear = LOOKUPVALUE('Date EOY'[Year],'Date EOY'[date],LastDateAvailable,'Date EOY'[Select a Calendar],SELECTEDVALUE('Date EOY'[Select a Calendar]))  
			VAR DTCChannels={"Digital","Full Price US Stores","Company Stores","Canada","Renew Stores"}
			Return
			CALCULATE (
			    DIVIDE(
			        [EOP External $ On Hand POS]+CALCULATE([EOP Retail $ On Hand], Channel[Finance Channel] in DTCChannels),
			        [EOP External Units On Hand POS]+CALCULATE([EOP Quantity On Hand], Channel[Finance Channel] in DTCChannels)
			    ),
			    ALLEXCEPT('Date EOY', 'Date EOY'[Select a Calendar],'Date EOY'[Week End Date]),
			    'Date EOY'[Week End Date]  = LastFiscalYearWeekAvailable &&
			    'Date EOY'[Year] = LastFiscalYear       
			        )
			```
		formatString: $#,###;($#,###)
		displayFolder: Executive Dashboard\Stock AUR\Total Company
		lineageTag: 192d3493-8494-472b-843b-9eacb0bc4a5d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Executive Summary Stock AUR Total YTD' = ```
			VAR DayTY=CALCULATE(min('Date EOY'[Date]),'Date EOY'[Date]=TODAY())  //4/16/2026
			VAR YearTY=CALCULATE(max('Date EOY'[Year]),'Date EOY'[Date]=DayTY)    //2025
			VAR DTCChannels={"Digital","Full Price US Stores","Company Stores","Canada","Renew Stores"}
			Return 
			
			CALCULATE (
			    DIVIDE(
			        [EOP External $ On Hand POS]+CALCULATE([EOP Retail $ On Hand], Channel[Finance Channel] in DTCChannels),
			        [EOP External Units On Hand POS]+CALCULATE([EOP Quantity On Hand], Channel[Finance Channel] in DTCChannels)
			    ),
			   ALLEXCEPT('Date EOY', 'Date EOY'[Select a Calendar]),
			    'Date EOY'[Date]<=DayTY,
			     'Date EOY'[Year] = YearTY
			)
			
			```
		formatString: $#,###;($#,###)
		displayFolder: Executive Dashboard\Stock AUR\Total Company
		lineageTag: b4477f6b-8b08-43e5-9ac4-cd10adce67fa

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Executive Summary Stock AUR Wholesale MTD' = ```
			
			VAR LastDateAvailable = max('Date'[Date])+ if(max('Date'[Date])>=today(),WEEKDAY(today(), 1)-8,0)
			VAR LastDayAvailable =  LOOKUPVALUE('Date EOY'[Dayofyear],'Date EOY'[date],LastDateAvailable,'Date EOY'[Select a Calendar],SELECTEDVALUE('Date EOY'[Select a Calendar]) )
			VAR LastFiscalYearMonthAvailable=LOOKUPVALUE('Date EOY'[Monthnum],'Date EOY'[date],LastDateAvailable,'Date EOY'[Select a Calendar],SELECTEDVALUE('Date EOY'[Select a Calendar]) )
			VAR LastFiscalYearMonthAvailablePrev=LOOKUPVALUE('Date EOY'[Monthnum],'Date EOY'[date],LastDateAvailable,'Date EOY'[Select a Calendar],SELECTEDVALUE('Date EOY'[Select a Calendar]) )-1
			VAR LastFiscalYear = LOOKUPVALUE('Date EOY'[Year],'Date EOY'[date],LastDateAvailable,'Date EOY'[Select a Calendar],SELECTEDVALUE('Date EOY'[Select a Calendar]) )  
			Return
			IF(ISBLANK(
			    CALCULATE (
			        [Wholesale AUR Average],
			    ALLEXCEPT('Date EOY', 'Date EOY'[Select a Calendar],'Date EOY'[MonthNum]),
			        'Date EOY'[Dayofyear]  <= LastDayAvailable &&
			        'Date EOY'[MonthNum]= LastFiscalYearMonthAvailable &&
			        'Date EOY'[Year] = LastFiscalYear
			    )),
			    CALCULATE (
			        [Wholesale AUR Average],
			    ALLEXCEPT('Date EOY', 'Date EOY'[Select a Calendar],'Date EOY'[MonthNum]),
			        'Date EOY'[Dayofyear]  <= LastDayAvailable &&
			        'Date EOY'[MonthNum]= LastFiscalYearMonthAvailablePrev &&
			        'Date EOY'[Year] = LastFiscalYear
			    ),
			    CALCULATE (
			        [Wholesale AUR Average],
			    ALLEXCEPT('Date EOY', 'Date EOY'[Select a Calendar],'Date EOY'[MonthNum]),
			        'Date EOY'[Dayofyear]  <= LastDayAvailable &&
			        'Date EOY'[MonthNum]= LastFiscalYearMonthAvailable &&
			        'Date EOY'[Year] = LastFiscalYear
			    )
			)
			```
		formatString: $#,###;($#,###)
		displayFolder: Executive Dashboard\Stock AUR\Wholesale
		lineageTag: f52c8ad3-1aa3-4483-885a-155d4f857228

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Executive Summary Stock AUR Wholesale WTD' = ```
			
			VAR LastDateAvailable = MIN(LASTDATE('Date'[Date]), LASTDATE('Date EOY'[Date]))
			VAR CurrentCalendar = SELECTEDVALUE('Date EOY'[Select a Calendar])
			
			-- Get the Fiscal Week and Year in one go for efficiency
			VAR LastFiscalYearWeekAvailable = 
			    LOOKUPVALUE(
			        'Date EOY'[Week End Date],
			        'Date EOY'[Date], LastDateAvailable,
			        'Date EOY'[Select a Calendar], CurrentCalendar
			    )
			
			VAR LastFiscalYear = 
			    LOOKUPVALUE(
			        'Date EOY'[Year],
			        'Date EOY'[Date], LastDateAvailable,
			        'Date EOY'[Select a Calendar], CurrentCalendar
			    )
			
			-- Define the Primary Calculation
			VAR PrimaryAUR = 
			    CALCULATE (
			        [Wholesale AUR Average],
			        REMOVEFILTERS('Date EOY'), -- Clears existing date filters to apply specific ones below
			        'Date EOY'[Select a Calendar] = CurrentCalendar,
			        'Date EOY'[Week End Date] = LastFiscalYearWeekAvailable,
			        'Date EOY'[Year] = LastFiscalYear
			    )
			
			-- Define the Fallback Calculation (Previous Week)
			VAR FallbackAUR = 
			    CALCULATE (
			        [Wholesale AUR Average],
			        REMOVEFILTERS('Date EOY'),
			        'Date EOY'[Select a Calendar] = CurrentCalendar,
			        'Date EOY'[Week End Date] = LastFiscalYearWeekAvailable - 7,
			        'Date EOY'[Year] = LastFiscalYear
			    )
			
			RETURN
			    IF(ISBLANK(PrimaryAUR), FallbackAUR, PrimaryAUR)
			```
		displayFolder: Executive Dashboard\Stock AUR\Wholesale
		lineageTag: 8dfa0fd7-c417-4137-8738-cb86a762a1f8

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Executive Summary Stock AUR Wholesale YTD' = ```
			
			VAR DayTY=CALCULATE(min('Date EOY'[Date]),'Date EOY'[Date]=TODAY())  //4/16/2026
			VAR YearTY=CALCULATE(max('Date EOY'[Year]),'Date EOY'[Date]=DayTY)    //2025
			Return 
			
			CALCULATE (
			    [Wholesale AUR Average],
			   ALLEXCEPT('Date EOY', 'Date EOY'[Select a Calendar]),
			    'Date EOY'[Date]<=DayTY,
			     'Date EOY'[Year] = YearTY
			)
			
			```
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Executive Dashboard\Stock AUR\Wholesale
		lineageTag: 6feb560e-4151-451e-82c1-5e161fbb1a79

