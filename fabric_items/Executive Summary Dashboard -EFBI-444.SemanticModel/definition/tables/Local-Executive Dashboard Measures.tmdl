			VAR LastFiscalYear = LOOKUPVALUE('Date EOY'[Year],'Date EOY'[date],LastDateAvailable,'Date EOY'[Select a Calendar],SELECTEDVALUE('Date EOY'[Select a Calendar]))
			Return
			    CALCULATE (
			        Divide(
			            CALCULATE(
			                [Budget],
			                KEEPFILTERS(or('Budget (Channel)'[Measure]="Invoiced Gross Margin $",'Budget (Channel)'[Measure]="Net Gross Margin $"))
			            ),
			            CALCULATE(
			                [Budget],
			                KEEPFILTERS(or('Budget (Channel)'[Measure]="Net Sales $",'Budget (Channel)'[Measure]="Net Retail Sales $"))
