	measure 'Retail MTD LY' =
			VAR LastDayAvailable = max('Date'[Date])+ if(max('Date'[Date])>=today(),WEEKDAY(today(), 1)-8,0)
			VAR LastDayLY=LOOKUPVALUE('Date'[Date LY],'Date'[Date],LastDayAvailable)
			VAR LY=CALCULATETABLE(SUMMARIZECOLUMNS('Date'[Date LY], FILTER('Date','Date'[Year]=max('Date'[Year]))),ALLEXCEPT('Date','Date'[Select a Calendar]))
			VAR LastMonth=LOOKUPVALUE('Date'[Monthnum],'Date'[Date],LastDayAvailable,'Date'[Select a Calendar],SELECTEDVALUE('Date'[Select a Calendar]))
			VAR LM=CALCULATETABLE(SUMMARIZECOLUMNS('Date'[Date LY], FILTER('Date','Date'[Monthnum]=LastMonth)),ALLEXCEPT('Date','Date'[Select a Calendar]))
			Return
			CALCULATE (
			    [Net External Retail Sales $ MIX],
			    ALLEXCEPT('Date', 'Date'[Select a Calendar]),
			    'Date'[Date] in LM &&
			    'Date'[Date] in LY &&
			    'Date'[Date]<=LastDayLY
			)
		formatString: $#,###;($#,###)
		displayFolder: Wholesale Retail\MTD
		lineageTag: 294f769c-bf07-43e0-b8b6-55c9bbba1904

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Retail MTD PL' = ```
			
			VAR LastFiscalYear = MAX('Date'[Year])
			VAR LastFiscalYearWeekAvailable = MAX ( 'Date'[Week End Date] )
			VAR LastFiscalYearMonthAvailable =CALCULATE(MAX('Date'[Monthnum]),'Date'[Date]=LastFiscalYearWeekAvailable)
			Return
			CALCULATE (
			    [Plan],
			    ALLEXCEPT('Date', 'Date'[Select a Calendar],'Date'[Week End Date]),
			     'Date'[Date] <= LastFiscalYearWeekAvailable &&  
			            'Date'[MonthNum] = LastFiscalYearMonthAvailable &&
			            'Date'[Year] = LastFiscalYear        
			)
			
			```
		formatString: $#,###;($#,###)
		displayFolder: Wholesale Retail\MTD
		lineageTag: d26f3d7e-c3e1-4a20-842c-e98bc9688ecd

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Retail MTD TY' = ```
			
			VAR LastFiscalYear = MAX('Date'[Year])
			VAR LastFiscalYearWeekAvailable = MAX ( 'Date'[Week End Date] )
			VAR LastFiscalYearMonthAvailable =CALCULATE(MAX('Date'[Monthnum]),'Date'[Date]=LastFiscalYearWeekAvailable)
			Return 
			CALCULATE (
