	measure 'Executive Summary Shipped TY' =
			
			switch(
			        selectedvalue('Headers - Executive Summary'[Business Unit]),
			        "Wholesale",
			            SWITCH(
			                SELECTEDVALUE('Headers - Executive Summary'[Period]),
			                "Week to Date",[Executive Summary Shipped Wholesale WTD TY],
			                "Month to Date",[Executive Summary Shipped Wholesale MTD TY],
			                "Year to Date",[Executive Summary Shipped Wholesale YTD TY]
			            ),
			        "DTC",
			            SWITCH(
			                SELECTEDVALUE('Headers - Executive Summary'[Period]),
			                "Week to Date",[Executive Summary Shipped DTC WTD TY],
			                "Month to Date",[Executive Summary Shipped DTC MTD TY],
			                "Year to Date",[Executive Summary Shipped DTC YTD TY]
			            ),
			        "Total Company",
			            SWITCH(
			                SELECTEDVALUE('Headers - Executive Summary'[Period]),
			                "Week to Date",[Executive Summary Shipped Total WTD TY],
			                "Month to Date",[Executive Summary Shipped Total MTD TY],
			                "Year to Date",[Executive Summary Shipped Total YTD TY]
			            )
			        )
		formatString: #,0
		displayFolder: Executive Dashboard\Inventory\Shipped
		lineageTag: 9ea9fe8f-42f3-463b-abeb-9ca53c7147da

