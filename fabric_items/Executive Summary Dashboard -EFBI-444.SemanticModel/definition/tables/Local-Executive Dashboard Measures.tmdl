			        CALCULATE (
			            [Net Invoiced Sales $],
			           ALLEXCEPT('Date EOY', 'Date EOY'[Select a Calendar],'Date EOY'[Week]),
			            'Date EOY'[Week End Date] = LastFiscalYearWeekAvailable &&
			            'Date EOY'[Year] = LastFiscalYear
			        )
			)
			 
			```
		formatString: $#,###;($#,###)
		displayFolder: Wholesale Shipping\Month
		lineageTag: d96452db-e6af-4358-b52c-65099a8282c4

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Wholesale LY MTD' =
			
			VAR LastDayAvailable = if(SELECTEDVALUE('Date'[Week End Date])>TODAY(),SELECTEDVALUE('Date'[Week End Date]),max('Date'[Date])+ if(max('Date'[Date])>=today(),WEEKDAY(today(), 1)-8,0))
			VAR LastDayLY=LOOKUPVALUE('Date EOY'[Date LY],'Date EOY'[Date],LastDayAvailable)
			VAR LastYear=LOOKUPVALUE('Date EOY'[Year],'Date EOY'[Date],LastDayAvailable,'Date EOY'[Select a Calendar],SELECTEDVALUE('Date EOY'[Select a Calendar]))
			VAR LY=CALCULATETABLE(SUMMARIZECOLUMNS('Date EOY'[Date LY], FILTER('Date EOY','Date EOY'[Year]=LastYear)),ALLEXCEPT('Date EOY','Date EOY'[Select a Calendar]))
			VAR LastMonth=LOOKUPVALUE('Date EOY'[Monthnum],'Date EOY'[Date],LastDayAvailable,'Date EOY'[Select a Calendar],SELECTEDVALUE('Date EOY'[Select a Calendar]))
			VAR LM=CALCULATETABLE(SUMMARIZECOLUMNS('Date EOY'[Date LY], FILTER('Date EOY','Date EOY'[Monthnum]=LastMonth)),ALLEXCEPT('Date EOY','Date EOY'[Select a Calendar]))
			Return
			CALCULATE (
			    [Net Invoiced Sales $],
			    ALLEXCEPT('Date EOY', 'Date EOY'[Select a Calendar]),
			    'Date EOY'[Date] in LM &&
			    'Date EOY'[Date] in LY &&
			    'Date EOY'[Date]<=LastDayLY
			)
		formatString: $#,###;($#,###)
		displayFolder: Wholesale Shipping\Month
		lineageTag: 82252584-069d-4e87-9bc7-57aee2846a81

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Wholesale LY YTD' =
			
			VAR LastDayAvailable = if(SELECTEDVALUE('Date'[Week End Date])>TODAY(),SELECTEDVALUE('Date'[Week End Date]),max('Date'[Date])+ if(max('Date'[Date])>=today(),WEEKDAY(today(), 1)-8,0))
			VAR LastDayLY=LOOKUPVALUE('Date EOY'[Date LY],'Date EOY'[Date],LastDayAvailable)
			VAR LastYear=LOOKUPVALUE('Date EOY'[Year],'Date EOY'[Date],LastDayAvailable,'Date EOY'[Select a Calendar],SELECTEDVALUE('Date EOY'[Select a Calendar]))
			VAR LY=CALCULATETABLE(SUMMARIZECOLUMNS('Date EOY'[Date LY], FILTER('Date EOY','Date EOY'[Year]=LastYear)),ALLEXCEPT('Date EOY','Date EOY'[Select a Calendar]))
			Return
			CALCULATE (
			    [Net Invoiced Sales $],
			    ALLEXCEPT('Date EOY', 'Date EOY'[Select a Calendar]),
			    'Date EOY'[Date] in LY &&
			    'Date EOY'[Date]<=LastDayLY
			)
		formatString: $#,###;($#,###)
		displayFolder: Wholesale Shipping\Year
		lineageTag: 754fdc22-1732-47fe-aefb-bb96e2c3e514

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Wholesale TY MTD' = ```
			
			VAR LastDateAvailable = if(SELECTEDVALUE('Date EOY'[Week End Date])>TODAY(),SELECTEDVALUE('Date EOY'[Week End Date]),max('Date'[Date])+ if(max('Date'[Date])>=today(),WEEKDAY(today(), 1)-8,0))
			VAR LastDayAvailable =  LOOKUPVALUE('Date EOY'[Monthindex],'Date EOY'[date],LastDateAvailable,'Date EOY'[Select a Calendar],SELECTEDVALUE('Date EOY'[Select a Calendar]) )
			VAR LastFiscalYearMonthAvailable = LOOKUPVALUE('Date'[MonthNum],'Date'[date],LastDateAvailable,'Date'[Select a Calendar],SELECTEDVALUE('Date EOY'[Select a Calendar]) )
			VAR LastFiscalYear = LOOKUPVALUE('Date EOY'[Year],'Date EOY'[date],LastDateAvailable,'Date EOY'[Select a Calendar],SELECTEDVALUE('Date EOY'[Select a Calendar]) )  
			Return
			CALCULATE (
			    [Net Invoiced Sales $],
			    ALLEXCEPT('Date EOY', 'Date EOY'[Select a Calendar]),
			    'Date EOY'[MonthIndex]  <= LastDayAvailable &&
			    'Date EOY'[MonthNum]= LastFiscalYearMonthAvailable &&
			    'Date EOY'[Year] = LastFiscalYear           
			)
			```
		formatString: $#,###;($#,###)
		displayFolder: Wholesale Shipping\Month
		lineageTag: 848f34db-081a-4bce-a0e1-956e710a2a0f

	measure 'Wholesale TY YTD' =
			
			VAR LastDateAvailable = if(SELECTEDVALUE('Date EOY'[Week End Date])>TODAY(),SELECTEDVALUE('Date EOY'[Week End Date]),max('Date'[Date])+ if(max('Date'[Date])>=today(),WEEKDAY(today(), 1)-8,0))
			VAR LastDayAvailable =  LOOKUPVALUE('Date EOY'[Dayofyear],'Date EOY'[date],LastDateAvailable,'Date EOY'[Select a Calendar],SELECTEDVALUE('Date EOY'[Select a Calendar]) )
			VAR LastFiscalYear = LOOKUPVALUE('Date EOY'[Year],'Date EOY'[Date],LastDateAvailable,'Date EOY'[Select a Calendar],SELECTEDVALUE('Date EOY'[Select a Calendar]) )
			RETURN
			CALCULATE (
			    [Net Invoiced Sales $],
			    ALLEXCEPT('Date EOY', 'Date EOY'[Select a Calendar]),
			    'Date EOY'[DayOfYear]  <= LastDayAvailable &&
			    'Date EOY'[Year] = LastFiscalYear
			)
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Wholesale Shipping\Year
		lineageTag: a51c739d-5b33-4549-be69-58a0d5bf3088

