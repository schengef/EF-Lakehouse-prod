	measure 'Executive Summary Sales AUR DTC MTD LY' = ```
			
			VAR LastDateAvailable=min(LASTDATE('Date'[Date]),LASTDATE('Date EOY'[Date]))
			VAR LastDayAvailable = LastDateAvailable+ if(LastDateAvailable>=today(),WEEKDAY(today(), 1)-8,0)
			VAR LastDayLY=LOOKUPVALUE('Date EOY'[Date LY],'Date EOY'[Date],LastDayAvailable)
			VAR LastYear=LOOKUPVALUE('Date EOY'[Year],'Date EOY'[Date],LastDayAvailable,'Date EOY'[Select a Calendar],SELECTEDVALUE('Date EOY'[Select a Calendar]))
			VAR LY=CALCULATETABLE(SUMMARIZECOLUMNS('Date EOY'[Date LY], FILTER('Date EOY','Date EOY'[Year]=LastYear)),ALLEXCEPT('Date EOY','Date EOY'[Select a Calendar]))
			VAR LastMonth=LOOKUPVALUE('Date EOY'[Monthnum],'Date EOY'[Date],LastDayAvailable,'Date EOY'[Select a Calendar],SELECTEDVALUE('Date EOY'[Select a Calendar]))
			VAR LM=CALCULATETABLE(SUMMARIZECOLUMNS('Date EOY'[Date LY], FILTER('Date EOY','Date EOY'[Monthnum]=LastMonth)),ALLEXCEPT('Date EOY','Date EOY'[Select a Calendar]))  
			Return
			CALCULATE (
			    [Net Sales AUR],
			    ALLEXCEPT('Date EOY', 'Date EOY'[Select a Calendar]),
			    'Date EOY'[Date] in LM &&
			    'Date EOY'[Date] in LY &&
			    'Date EOY'[Date]<=LastDayLY     
			)
