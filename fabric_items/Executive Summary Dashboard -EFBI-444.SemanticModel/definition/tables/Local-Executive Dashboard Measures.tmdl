	measure 'Executive Summary Sales Budget $' =
			
			SWITCH(
			    SELECTEDVALUE('Headers - Executive Summary'[Business Unit]),
			    "Wholesale",
			        SWITCH(
			            selectedvalue('Headers - Executive Summary'[Period]),
			            "Week to Date",[Executive Summary Invoiced Sales Budget Week],
			            "Month to Date",[Executive Summary Invoiced Sales Budget Month],
			            "Year to Date",[Executive Summary Invoiced Sales Budget Year]
			        ),
			    "DTC",
			        SWITCH(
			            selectedvalue('Headers - Executive Summary'[Period]),
			            "Week to Date",[Executive Summary Net Sales Budget Week],
			            "Month to Date",[Executive Summary Net Sales Budget Month],
			            "Year to Date",[Executive Summary Net Sales Budget Year]
			        ),
			    "Total Company",
			        SWITCH(
			            selectedvalue('Headers - Executive Summary'[Period]),
			            "Week to Date",[Executive Summary Net Sales Budget Week]+[Executive Summary Invoiced Sales Budget Week],
			            "Month to Date",[Executive Summary Net Sales Budget Month]+[Executive Summary Invoiced Sales Budget Month],
			            "Year to Date",[Executive Summary Net Sales Budget Year]+[Executive Summary Invoiced Sales Budget Year]
			        )
