	measure 'DTC AUR Average' =
			
			VAR AggregatedInCurrency=
			ADDCOLUMNS(
			    SUMMARIZE(
			        'Date EOY',
			        'Date EOY'[Date]
			    ),
			    "@Cost",calculate([EOP Retail $ On Hand]),
			    "@Units",calculate([EOP Quantity On Hand])
			)  //Creates a table summing dollars by date with the currently selected and default conversion rate for that date
			RETURN
			AVERAGEX(AggregatedInCurrency,DIVIDE([@Cost],[@Units]))
		displayFolder: Executive Dashboard\Stock AUR\DTC
		lineageTag: 76aecc7f-8483-4674-966f-7cc23b1c5164

		changedProperty = Name

		changedProperty = DisplayFolder

