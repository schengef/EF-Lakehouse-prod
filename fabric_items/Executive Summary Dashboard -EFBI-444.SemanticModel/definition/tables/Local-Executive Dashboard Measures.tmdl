	measure 'Executive Summary Sales LY $' =
			
			SWITCH(
			    SELECTEDVALUE('Headers - Executive Summary'[Business Unit]),
			    "Wholesale",
			        SWITCH(
			            selectedvalue('Headers - Executive Summary'[Period]),
			            "Week to Date",[Executive Summary Invoiced Sales LY WTD],
			            "Month to Date",[Executive Summary Invoiced Sales LY MTD],
			            "Year to Date",[Executive Summary Invoiced Sales LY YTD]
			        ),
			    "DTC",
			        SWITCH(
			            selectedvalue('Headers - Executive Summary'[Period]),
			            "Week to Date",[Executive Summary Net Sales LY WTD],
			            "Month to Date",[Executive Summary Net Sales LY MTD],
			            "Year to Date",[Executive Summary Net Sales LY YTD]
			        ),
			    "Total Company",
			        SWITCH(
			            selectedvalue('Headers - Executive Summary'[Period]),
			            "Week to Date",[Executive Summary Net Sales LY WTD]+[Executive Summary Invoiced Sales LY WTD],
			            "Month to Date",[Executive Summary Net Sales LY MTD]+[Executive Summary Invoiced Sales LY MTD],
