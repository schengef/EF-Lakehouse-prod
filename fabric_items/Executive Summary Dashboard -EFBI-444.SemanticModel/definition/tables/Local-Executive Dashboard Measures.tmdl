	measure 'Net Demand Budget Summary' = ```
			
			//_DTC_Budget_Summary({"Net Retail Sales $"})
			
			
			//(_BudgetName : anyval)=>
			VAR Period = SELECTEDVALUE('Headers - DTC'[Period])
			VAR LastDateAvailable = LASTDATE('Date'[Date]) 
			VAR LastFiscalYear = MAX('Date'[Year])
			VAR LastFiscalYearMonthAvailable = LOOKUPVALUE('Date'[MonthNum],'Date'[date],LastDateAvailable,'Date'[Select a Calendar],SELECTEDVALUE('Date EOY'[Select a Calendar]) )
			VAR LastFiscalYearWeekAvailable = MAX ( 'Date'[Week End Date] )
			
			VAR Week = 
			    CALCULATE (
			            [Budget Net Demand],
			            KEEPFILTERS('Budget (Channel)'[Channel] = "Digital"),
			            KEEPFILTERS('Budget (Channel)'[Measure] in {"Net Retail Sales $"}),
			            ALLEXCEPT('Date EOY', 'Date EOY'[Select a Calendar]),
			            'Date EOY'[Date] <= LastDateAvailable &&  
			            'Date EOY'[Week End Date] = LastFiscalYearWeekAvailable &&
			            'Date EOY'[Year] = LastFiscalYear
			        )
			        
			VAR Month = 
			    CALCULATE (
			            [Budget Net Demand],
			            KEEPFILTERS('Budget (Channel)'[Channel] = "Digital"),
			            KEEPFILTERS('Budget (Channel)'[Measure] in {"Net Retail Sales $"}),
			            ALLEXCEPT('Date EOY', 'Date EOY'[Select a Calendar]),
			            'Date EOY'[Date] <= LastDateAvailable &&  
			            'Date EOY'[MonthNum] = LastFiscalYearMonthAvailable &&
			            'Date EOY'[Year] = LastFiscalYear
			        )
			
			VAR Year = 
			    CALCULATE (
			            [Budget Net Demand],
			            KEEPFILTERS('Budget (Channel)'[Channel] = "Digital"),
			            KEEPFILTERS('Budget (Channel)'[Measure] in {"Net Retail Sales $"}),
			            ALLEXCEPT('Date EOY', 'Date EOY'[Select a Calendar]),
			            'Date EOY'[Date] <= LastDateAvailable &&  
			            'Date EOY'[Year] = LastFiscalYear
			        )
			   
			Return
			    Switch(
			    Period,
			    "     WTD     ",Week,
			    "     MTD     ",Month,
			    "     YTD     ",Year
			    )
			```
		formatString: $#,###;($#,###)
		displayFolder: Weekly DTC (Detail)\Net Demand\summary
		lineageTag: 23b729eb-a930-4a0c-a383-9ab07b59d612

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Net Demand LLY Summary' = ```
			//_DTC_LY_Summary( [Demand Net Retail Sales $] )
			
			
			//(_measure : scalar decimal expr)=>
			VAR Period = SELECTEDVALUE('Headers - DTC'[Period])
			VAR LastDayAvailable = if(SELECTEDVALUE('Date'[Week End Date])>TODAY(),SELECTEDVALUE('Date'[Week End Date]),max('Date'[Date])+ if(max('Date'[Date])>=today(),WEEKDAY(today(), 1)-8,0))
			VAR LastDayLlY=LOOKUPVALUE('Date EOY'[Date LLY],'Date EOY'[Date],LastDayAvailable)
			VAR LastYear=LOOKUPVALUE('Date EOY'[Year],'Date EOY'[Date],LastDayAvailable,'Date EOY'[Select a Calendar],SELECTEDVALUE('Date EOY'[Select a Calendar]))
			VAR LLY=CALCULATETABLE(SUMMARIZECOLUMNS('Date EOY'[Date LLY], FILTER('Date EOY','Date EOY'[Year]=LastYear)),ALLEXCEPT('Date EOY','Date EOY'[Select a Calendar]))
			VAR LastMonth=LOOKUPVALUE('Date EOY'[Monthnum],'Date EOY'[Date],LastDayAvailable,'Date EOY'[Select a Calendar],SELECTEDVALUE('Date EOY'[Select a Calendar]))
			VAR LM=CALCULATETABLE(SUMMARIZECOLUMNS('Date EOY'[Date LLY], FILTER('Date EOY','Date EOY'[Monthnum]=LastMonth)),ALLEXCEPT('Date EOY','Date EOY'[Select a Calendar]))
			VAR LW=SUMMARIZECOLUMNS('Date EOY'[Date LLY], FILTER('Date EOY','Date EOY'[Week End Date]=max('Date'[Week End Date])))
			
			VAR Week = 
			    CALCULATE (
			            [Demand Net Retail Sales $] ,
			            ALLEXCEPT('Date EOY', 'Date EOY'[Select a Calendar]),
			            'Date EOY'[Date] in LW &&
			            'Date EOY'[Date]<=LastDayLLY
			        )
			        
			VAR Month = 
			    CALCULATE (
			            [Demand Net Retail Sales $] ,
			            ALLEXCEPT('Date EOY', 'Date EOY'[Select a Calendar]),
			            'Date EOY'[Date] in LM &&
			            'Date EOY'[Date] in LLY &&
			            'Date EOY'[Date]<=LastDayLLY
			        )
			
			VAR Year = 
			    CALCULATE (
			            [Demand Net Retail Sales $] ,
			            ALLEXCEPT('Date EOY', 'Date EOY'[Select a Calendar]),
			            'Date EOY'[Date] in LLY &&
			            'Date EOY'[Date]<=LastDayLLY
			        )
			   
			Return
			    Switch(
			    Period,
			    "     WTD     ",Week,
			    "     MTD     ",Month,
			    "     YTD     ",Year
			    )
			
			```
		formatString: $#,###;($#,###)
		displayFolder: Weekly DTC (Detail)\Net Demand\summary
		lineageTag: aeb5ae9c-e7e6-42e5-b041-ee5190ae9dce

		annotation PBI_FormatHint = {"isCustom":true}

