	measure 'Budget Wholesale IMU%' =
			
			VAR GrossSales=
			CALCULATE(
			    [Budget],
			    KEEPFILTERS('Budget (Channel)'[Measure]="Gross Sales $"),
			    CONTAINSSTRING('Budget (Channel)'[Channel],"WHOLESALE")
			    )
			
			VAR Returns=
			CALCULATE(
			    [Budget],
			    KEEPFILTERS('Budget (Channel)'[Measure]="Gross Return (RTV) $"),
			    CONTAINSSTRING('Budget (Channel)'[Channel],"WHOLESALE")
			    )
			
			VAR COGS = CALCULATE(
			    [Budget],
			    KEEPFILTERS('Budget (Channel)'[Measure]="Total Standard Cost $"),
			    CONTAINSSTRING('Budget (Channel)'[Channel],"WHOLESALE")
			    )
			RETURN
			DIVIDE(GrossSales+Returns-COGS,GrossSales+Returns)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 2c029a16-1145-4885-8877-3bb5341af619

		changedProperty = Name

		changedProperty = FormatString

