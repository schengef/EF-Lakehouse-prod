		lineageTag: 21b68f28-2e77-4b8b-9ec6-f0a06019530c

		annotation PBI_FormatHint = {"isCustom":true}

	measure 'Executive Summary IMU Wholesale YTD Budget' = ```
			VAR DayTY=CALCULATE(min('Date EOY'[Date]),'Date EOY'[Date]=TODAY())  //4/16/2026
			VAR YearTY=CALCULATE(max('Date EOY'[Year]),'Date EOY'[Date]=DayTY)    //2025
			Return 
			CALCULATE (
