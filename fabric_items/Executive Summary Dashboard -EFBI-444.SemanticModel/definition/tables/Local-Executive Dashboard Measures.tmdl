	measure 'Retail Summary MTD %LY' =
			
			VAR StoreType={"DPT","DNM"}
			VAR WebType={"MOW","MNM"}
			RETURN
			SWITCH(
			    SELECTEDVALUE('Headers - Wholesale Retail'[Summary Rows]),
			    "DOMESTIC STORELINE", CALCULATE(
			        divide([Retail MTD TY]-[Retail MTD LY],[Retail MTD LY]),
			        KEEPFILTERS('Store'[Store Type] in StoreType)
			        ),
			    "DOMESTIC WEB",CALCULATE(
			        divide([Retail MTD TY]-[Retail MTD LY],[Retail MTD LY]),
			        KEEPFILTERS('Store'[Store Type] in WebType)
			        ),
			    "TOTAL",divide([Retail MTD TY]-[Retail MTD LY],[Retail MTD LY])
			)
		formatString: 0.0%;(0.0%)
		displayFolder: Wholesale Retail\Summary\MTD
		lineageTag: 0a5a4234-2a5b-4b3d-b30e-1bf9da1b8bd0

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Retail Summary MTD %PL' =
			
			SWITCH(
			    SELECTEDVALUE('Headers - Wholesale Retail'[Summary Rows]),
			    "DOMESTIC STORELINE", CALCULATE(
			        divide([Retail MTD TY]-[Retail MTD PL],[Retail MTD PL]),
			        KEEPFILTERS('Plan (Wholesale Retail)'[Type]="STORELINE"),
			        KEEPFILTERS('Store'[Store Type]="DPT")
			        ),
			    "DOMESTIC WEB",CALCULATE(
			        divide([Retail MTD TY]-[Retail MTD PL],[Retail MTD PL]),
			        KEEPFILTERS('Plan (Wholesale Retail)'[Type]="WEB"),
			        KEEPFILTERS('Store'[Store Type]="MOW")
			        ),
			    "TOTAL",divide([Retail MTD TY]-[Retail MTD PL],[Retail MTD PL])
			)
		formatString: 0.0%;(0.0%)
		displayFolder: Wholesale Retail\Summary\MTD
		lineageTag: 708f2ec3-f965-43e0-9480-32a8d847e458

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Retail Summary MTD LY' =
			
			VAR StoreType={"DPT","DNM"}
