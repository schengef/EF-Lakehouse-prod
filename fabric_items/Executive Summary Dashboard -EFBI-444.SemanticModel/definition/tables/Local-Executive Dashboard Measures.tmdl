	measure 'Row Category Delivery Year Month' =
			
			VAR CurrMonth=LOOKUPVALUE('Date'[MonthNum],'Date'[Date],MAX('Date'[Date]),'Date'[Select a Calendar],SELECTEDVALUE('Date'[Select a Calendar]))
			VAR CurrYear=LOOKUPVALUE('Date'[Year],'Date'[Date],MAX('Date'[Date]),'Date'[Select a Calendar],SELECTEDVALUE('Date'[Select a Calendar]))
			VAR SeasonShort=IF(or(CurrMonth<5,CurrMonth>10),"06","12")
			VAR YearShort=right(if(CurrMonth <11,CurrYear,CurrYear+1),2)
			VAR DeliveryCodeKey=LOOKUPVALUE(Delivery[Delivery Code Key],Delivery[Delivery Code],YearShort&SeasonShort)
			RETURN
			DeliveryCodeKey-SELECTEDVALUE('Delivery'[Delivery Code Key])
		formatString: 0
		lineageTag: 7460c897-6188-422a-8831-a13d41bebdc6

	measure 'Cost OH $ LY Delivery' =
			
			VAR LastDayAvailable = max('Date'[Week End Date])
			VAR LastDayLY=LOOKUPVALUE('Date'[Date LY],'Date'[Date],LastDayAvailable)
			RETURN
			IF(
			    OR(ISFILTERED(Delivery[Season]),ISFILTERED(Delivery[Delivery Month])),
			    CALCULATE(
			        [EOP Cost $ On Hand],
			        ALLEXCEPT('Delivery','Delivery'[Delivery Month]),
			        ALLEXCEPT('Date','Date'[Select a Calendar]),
			        'Delivery'[Delivery Year]=format(IFERROR(VALUE(SELECTEDVALUE('Delivery'[Delivery Year])),0)-1,"####"),
			        'Date'[Date]=LastDayLY
			    ),
			    [Cost OH $ LY]
			)
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: b554287a-1f3a-4d44-a80a-aaf5b09d4ca8

		changedProperty = Name

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Cost OH $ LY' =
			
