	measure 'Returns Budget' =
			VAR ReturnBudgets={"DC Returns Retail $ (Digital Purchase)","Store Returns Retail $ (Store Purchase)","Store Returns Retail $ (Digital Purchase)"}
			RETURN
			CALCULATE (
			    [Budget],
			    KEEPFILTERS('Budget (Channel)'[Measure] IN ReturnBudgets)
			)
		formatString: $#,###;($#,###)
		displayFolder: Weekly DTC (Detail)\Returns
		lineageTag: 6981ac25-13ac-475a-ae13-4e365351ec73

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Returns Forecast' =
			VAR ReturnBudgets={"DC Returns Retail $ (Digital Purchase)","Store Returns Retail $ (Store Purchase)","Store Returns Retail $ (Digital Purchase)"}
			RETURN
			CALCULATE (
			    [Forecast],
			    KEEPFILTERS('Forecast (Channel)'[Measure] IN ReturnBudgets)
			)
		formatString: $#,###;($#,###)
		displayFolder: Weekly DTC (Detail)\Returns
		lineageTag: b71cec8e-f7c5-42b0-b0e0-b31cd908a27c

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Returns LLY' =
			
			VAR LastDayAvailable = max('Date EOY'[Date])
			VAR LastDayLLY=LOOKUPVALUE('Date EOY'[Date LLY],'Date EOY'[Date],LastDayAvailable)
			VAR LLY=SUMMARIZECOLUMNS('Date EOY'[Date LLY], FILTER('Date EOY','Date EOY'[Year]=max('Date EOY'[Year])))
			RETURN
			CALCULATE (
			    [Retail Returns $],
			    ALLEXCEPT('Date EOY', 'Date EOY'[Select a Calendar]),
			    'Date EOY'[Date] in LLY &&
			    'Date EOY'[Date]<=LastDayLLY
			)
		formatString: $#,###;($#,###)
		displayFolder: Weekly DTC (Detail)\Returns
		lineageTag: b7382189-bf5b-46d3-b554-bf260c8fbcda

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Returns LY' =
			
			VAR LastDayAvailable = max('Date EOY'[Date])
			VAR LastDayLY=LOOKUPVALUE('Date EOY'[Date LY],'Date EOY'[Date],LastDayAvailable)
			VAR LY=SUMMARIZECOLUMNS('Date EOY'[Date LY], FILTER('Date EOY','Date EOY'[Year]=max('Date EOY'[Year])))
			RETURN
			CALCULATE (
			    [Retail Returns $],
			    ALLEXCEPT('Date EOY', 'Date EOY'[Select a Calendar]),
			    'Date EOY'[Date] in LY &&
			    'Date EOY'[Date]<=LastDayLY
			)
		formatString: $#,###;($#,###)
		displayFolder: Weekly DTC (Detail)\Returns
		lineageTag: 17aea771-f475-467c-8008-45b92ea7be05

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Returns TY' = [Retail Returns $]
		formatString: $#,###;($#,###)
		displayFolder: Weekly DTC (Detail)\Returns
		lineageTag: eef10bad-705c-4d2d-8377-ccb9df8acfbf

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'EOP Cost $ On Hand Actual' = ```
			VAR LastDOW =  DATEADD(LASTDATE('Date EOY'[Date]),-1*WEEKDAY(LASTDATE('Date EOY'[Date]),1),DAY)
			VAR LastFiscalYear = MAX ( 'Date EOY'[Year] )
			Return
			CALCULATE (
			    [EOP Cost $ On Hand],
			    ALLEXCEPT('Date EOY', 'Date EOY'[Select a Calendar], 'Date EOY'[Week End Date]),
			    'Date EOY'[Week End Date] = LastDOW &&
			    'Date EOY'[Year] = LastFiscalYear
			)
			           
			```
		formatString: $#,###;($#,###)
		displayFolder: Executive Dashboard\Inventory
		lineageTag: 64ba0e42-3977-40f0-80d0-7ca863f2051e

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'EOP Cost $ On Hand Budget' =
			CALCULATE (
			    [Inventory Budget (Sum)],
			    'Budget (Inventory)'[Date Key]=max('Budget (Inventory)'[Date Key])
			)
		formatString: $#,###;($#,###)
		displayFolder: Executive Dashboard\Inventory
		lineageTag: 82b2d450-325f-47bd-9391-6bbf8165eb62

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'EOP Cost $ On Hand LY' =
			VAR LastDayAvailable = max('Date'[Date])+ if(max('Date'[Date])>=today(),WEEKDAY(today(), 1)-8,0)
			VAR LastDayLY=LOOKUPVALUE('Date EOY'[Date LY],'Date EOY'[Date],LastDayAvailable)
			Return
			 CALCULATE (
			    [EOP Cost $ On Hand],
			    ALLEXCEPT('Date EOY', 'Date EOY'[Select a Calendar]),
			    'Date EOY'[Date]=LastDayLY
			)
		formatString: $#,###;($#,###)
		displayFolder: Executive Dashboard\Inventory
		lineageTag: 657373d1-f065-4d81-8b65-5da7203cbd3f

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Executive Summary Full Price TY' =
			
			switch(
			        selectedvalue('Headers - Executive Summary'[Business Unit]),
			        "Wholesale",
			            SWITCH(
			                SELECTEDVALUE('Headers - Executive Summary'[Period]),
			                "Week to Date",[Executive Summary Full Price Wholesale WTD TY],
			                "Month to Date",[Executive Summary Full Price Wholesale MTD TY],
			                "Year to Date",[Executive Summary Full Price Wholesale YTD TY]
			            ),
			        "DTC",
			            SWITCH(
			                SELECTEDVALUE('Headers - Executive Summary'[Period]),
			                "Week to Date",[Executive Summary Full Price DTC WTD TY],
			                "Month to Date",[Executive Summary Full Price DTC MTD TY],
			                "Year to Date",[Executive Summary Full Price DTC YTD TY]
			            ),
			        "Total Company",
			            SWITCH(
			                SELECTEDVALUE('Headers - Executive Summary'[Period]),
			                "Week to Date",[Executive Summary Full Price Total WTD TY],
			                "Month to Date",[Executive Summary Full Price Total MTD TY],
			                "Year to Date",[Executive Summary Full Price Total YTD TY]
			            )
			        )
		formatString: 0.0%;(0.0%)
		displayFolder: Executive Dashboard\Full Price
		lineageTag: 2d861b28-0247-4dd9-8bbb-f6cdf6a3fb8b

	measure 'Executive Summary Full Price DTC MTD TY' = ```
			
			VAR LastDateAvailable=min(LASTDATE('Date'[Date]),LASTDATE('Date EOY'[Date]))
			VAR LastDayAvailable =  LOOKUPVALUE('Date EOY'[MonthIndex],'Date EOY'[date],LastDateAvailable,'Date EOY'[Select a Calendar],SELECTEDVALUE('Date EOY'[Select a Calendar]))
			VAR LastFiscalYearMonthAvailable = LOOKUPVALUE('Date EOY'[Monthnum],'Date EOY'[date],LastDateAvailable,'Date EOY'[Select a Calendar],SELECTEDVALUE('Date EOY'[Select a Calendar]))
			VAR LastFiscalYear = LOOKUPVALUE('Date EOY'[Year],'Date EOY'[date],LastDateAvailable,'Date EOY'[Select a Calendar],SELECTEDVALUE('Date EOY'[Select a Calendar]))   
			Return
			CALCULATE (
			    [DTC Full Price %],
			   ALLEXCEPT('Date EOY', 'Date EOY'[Select a Calendar],'Date EOY'[MonthNum]),
			    'Date EOY'[MonthIndex]  <= LastDayAvailable &&
			     'Date EOY'[MonthNum]= LastFiscalYearMonthAvailable &&
			    'Date EOY'[Year] = LastFiscalYear       
			)
			```
		formatString: 0.0%;(0.0%)
		displayFolder: Executive Dashboard\Full Price\DTC
		lineageTag: da443a77-53b9-40b6-9b73-af19172ba599

	measure 'Executive Summary Full Price DTC WTD TY' = ```
			
			VAR LastDateAvailable=min(LASTDATE('Date'[Date]),LASTDATE('Date EOY'[Date]))
			VAR LastFiscalYearWeekAvailable = LOOKUPVALUE('Date EOY'[Week End Date],'Date EOY'[date],LastDateAvailable,'Date EOY'[Select a Calendar],SELECTEDVALUE('Date EOY'[Select a Calendar]))
			VAR LastFiscalYear = LOOKUPVALUE('Date EOY'[Year],'Date EOY'[date],LastDateAvailable,'Date EOY'[Select a Calendar],SELECTEDVALUE('Date EOY'[Select a Calendar]))   
			Return    
			CALCULATE (
			    [DTC Full Price %],
			   ALLEXCEPT('Date EOY', 'Date EOY'[Select a Calendar],'Date EOY'[Week End Date]),
			    'Date EOY'[Week End Date]  = LastFiscalYearWeekAvailable &&
			    'Date EOY'[Year] = LastFiscalYear        
			)
			```
		formatString: 0.0%;(0.0%)
		displayFolder: Executive Dashboard\Full Price\DTC
		lineageTag: 07c0dd53-4ff5-491f-9322-cf9d6c1ff14f

	measure 'Executive Summary Full Price DTC YTD TY' = ```
			
			VAR DayTY=CALCULATE(min('Date EOY'[Date]),'Date EOY'[Date]=TODAY())  //4/16/2026
			VAR YearTY=CALCULATE(max('Date EOY'[Year]),'Date EOY'[Date]=DayTY)    //2025
			Return
			CALCULATE (
			    [DTC Full Price %],
			   ALLEXCEPT('Date EOY', 'Date EOY'[Select a Calendar]),
			    'Date EOY'[Date]<=DayTY,
			     'Date EOY'[Year] = YearTY
			)
			
			```
		formatString: 0.0%;(0.0%)
		displayFolder: Executive Dashboard\Full Price\DTC
		lineageTag: e62ecf7f-04f8-406d-ae4d-00cf043523ae

	measure 'Executive Summary Full Price Total TY' = ```
			
			CALCULATE(
			    [Net Retail Sales $],
