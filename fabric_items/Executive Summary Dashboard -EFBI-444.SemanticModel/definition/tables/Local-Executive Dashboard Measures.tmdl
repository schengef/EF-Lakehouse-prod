	measure 'Wholesale AUR Average' =
			
			VAR AggregatedInCurrency=
			ADDCOLUMNS(
			    SUMMARIZE(
			        'Date EOY',
			        'Date EOY'[Week End Date]
			    ),
			    "@Cost",calculate([EOP External $ On Hand POS]),
			    "@Units",calculate([EOP External Units On Hand POS])
